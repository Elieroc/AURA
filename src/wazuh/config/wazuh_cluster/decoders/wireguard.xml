<!--
  WireGuard (kernel module) has no native audit — no per-peer log, `wg show`
  only gives a point-in-time snapshot. Kernel `dynamic_debug` is unavailable
  on wireguard.lab (Proxmox LXC, /sys/kernel/debug inaccessible even as
  root — same constraint as the Aura-SOC manager).

  wg-monitor.py (wazuh/agents/wireguard/) reads WGDashboard's SQLite
  database — already installed on this host, already tracking peer state
  (running/stopped status computed by WGDashboard, source IP history per
  peer): no reason to poll `wg show` ourselves in parallel when this data
  already exists, with peer names as a bonus. Events in
  /var/log/wireguard-events.log, decoded here.
-->
<decoder name="wg-monitor">
  <prematch>wg-monitor: event=</prematch>
  <regex offset="after_prematch">^(\S+) peer_name=(\S+) peer_ip=(\S+) pubkey=(\S+) endpoint=(\S+)</regex>
  <order>event,peer_name,peer_ip,pubkey,endpoint</order>
</decoder>
