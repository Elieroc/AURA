<!--
  Jellyfin (Emby-based, embedded Kestrel server, network_mode host) — no
  nginx in front, and no structured HTTP log by default: verified on
  jellyfin.lab, 0 "GET "/"POST " lines in the application log at default
  verbosity. This is therefore NOT a "web" flow like NPM/BookStack/Nextcloud
  — its own index wazuh-jellyfin-*, not wazuh-web-*.

  Serilog format: "[2026-07-27 18:08:49.972 +02:00] [INF] [30]
  Emby.Server.Implementations.IO.LibraryMonitor: message". Standard Serilog
  levels: VRB/DBG/INF/WRN/ERR/FTL.

  Literal brackets (never character classes here, see
  pfsense-nohostname.xml and npm-proxy.xml for details on this limited
  regex engine) — "[" and "]" used as-is, unescaped.
-->
<decoder name="jellyfin">
  <prematch>[\d+-\d+-\d+ \d+:\d+:\d+.\d+ \S+] [</prematch>
  <regex offset="after_prematch">^(\w+)] [\d+] (\S+): </regex>
  <order>level,class</order>
</decoder>
