<!--
  WireGuard has no native audit (kernel module, no per-peer journal).
  wg-monitor.py (30s systemd timer on the agent, wazuh/agents/wireguard/)
  reads WGDashboard's SQLite database — already installed on
  wireguard.lab, already tracking peer state, no reason to poll `wg show`
  ourselves in parallel. Two sources in this database:
    - table <iface>: running/stopped status per peer (WGDashboard's
      computation).
    - table <iface>_history_endpoint: a peer's source IP change
      (roaming/new session), even if the running status hasn't changed.
  Decoded by decoders/wireguard.xml, events in
  /var/log/wireguard-events.log.
-->
<group name="local,vpn,">
  <rule id="100840" level="0">
    <decoded_as>wg-monitor</decoded_as>
    <description>WireGuard peer event grouped.</description>
  </rule>

  <rule id="100841" level="3">
    <if_sid>100840</if_sid>
    <field name="event">^peer_connected$</field>
    <description>WireGuard: peer $(peer_name) ($(peer_ip)) connected from $(endpoint).</description>
  </rule>

  <rule id="100842" level="3">
    <if_sid>100840</if_sid>
    <field name="event">^peer_disconnected$</field>
    <description>WireGuard: peer $(peer_name) ($(peer_ip)) disconnected ($(endpoint)).</description>
  </rule>

  <rule id="100844" level="3">
    <if_sid>100840</if_sid>
    <field name="event">^endpoint_changed$</field>
    <description>WireGuard: peer $(peer_name) ($(peer_ip)) reconnected from a new IP $(endpoint).</description>
  </rule>

  <!-- A new peer (never seen before) connecting: more interesting than a
       routine reconnection, but we have no inventory of "known" peers
       here — falls back to frequency: many connections/disconnections in
       quick succession from the same peer, a sign of an unstable link or
       a public-key scan (unlikely given Curve25519, but zero-cost to
       cover). -->
  <rule id="100843" level="7" frequency="6" timeframe="120" ignore="300">
    <if_matched_sid>100841</if_matched_sid>
    <same_field>peer_ip</same_field>
    <description>WireGuard: repeated reconnections from peer $(peer_name) ($(peer_ip)) (unstable link or anomaly).</description>
  </rule>

  <!-- Repeated, closely-spaced source IP changes for the same peer:
       normal roaming (wifi <-> 4G) or a sign that a private key is
       circulating on several machines/networks at once. -->
  <rule id="100845" level="7" frequency="4" timeframe="120" ignore="300">
    <if_matched_sid>100844</if_matched_sid>
    <same_field>peer_ip</same_field>
    <description>WireGuard: repeated source IP changes for peer $(peer_name) ($(peer_ip)) (roaming or shared key).</description>
  </rule>
</group>
