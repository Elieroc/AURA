<!-- Aura-SOC - rule 100953 (level 10). Domain: misp,threat_intel,cti,
     Naming convention and load-order trap: see rules/README.md -->
<group name="misp,threat_intel,cti,">

  <!-- Mass reputation list match (Data-Shield, blocklist.de, CINS Army).

       Level 10 ON PURPOSE, one below the incident threshold (MIN_LEVEL=12).
       These lists hold 100k+ IPs on a 15-day rolling window: every exposed SSH
       or web port matches them several times an hour. Promoting that to an
       incident would drown the AI pipeline in the exact noise it was built to
       cut. The signal keeps its value as CONTEXT - visible in the dashboard,
       attached to an incident opened by another rule (ATTACH_MIN_LEVEL=3). -->

  <rule id="100953" level="10">
    <if_sid>100950</if_sid>
    <field name="misp.confidence" type="pcre2">^bulk$</field>
    <description>CTI - IP with known bad reputation: $(misp.ioc) ($(misp.direction), list $(misp.source): $(misp.event_info))</description>
  </rule>

</group>
