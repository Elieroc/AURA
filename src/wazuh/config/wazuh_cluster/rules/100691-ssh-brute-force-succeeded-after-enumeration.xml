<!-- Aura-SOC - rule 100691 (level 14). Domain: authentication,ssh,threat_hunting,
     Naming convention and load-order trap: see rules/README.md -->
<group name="authentication,ssh,threat_hunting,">

  <!-- Failures against NON-EXISTENT accounts (5710) followed by a success =
       account enumeration then a valid login. Stronger signal than 100690: the
       attacker guessed the account name along with the password. -->

  <rule id="100691" level="14" frequency="5" timeframe="300">
    <if_sid>5715</if_sid>
    <if_matched_sid>5710</if_matched_sid>
    <same_source_ip />
    <description>SSH brute force SUCCEEDED after account enumeration: success from an IP that probed non-existent accounts ($(srcip) -> account $(dstuser))</description>
    <mitre>
      <id>T1110</id>
      <id>T1078</id>
      <id>T1589.001</id>
    </mitre>
    <group>authentication_success,attack,</group>
  </rule>

</group>
