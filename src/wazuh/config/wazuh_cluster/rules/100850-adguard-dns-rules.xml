<!--
  AdGuard Home: query log already in structured JSON (one line per DNS
  query), decoded by the native generic "json" decoder (no custom decoder
  needed) — QH (queried hostname), IP (client), Result.IsFiltered
  (blocked by a filtering rule).
-->
<group name="local,dns,">
  <rule id="100850" level="0">
    <decoded_as>json</decoded_as>
    <field name="QH">\.+</field>
    <description>AdGuard Home DNS query grouped.</description>
  </rule>

  <rule id="100851" level="3">
    <if_sid>100850</if_sid>
    <field name="Result.IsFiltered">^true$</field>
    <description>AdGuard Home: DNS query blocked for $(QH) from $(IP).</description>
  </rule>

  <rule id="100853" level="2">
    <if_sid>100850</if_sid>
    <match negate="yes">"IsFiltered":true</match>
    <description>AdGuard Home: DNS query allowed for $(QH) from $(IP).</description>
  </rule>

  <!-- Many blocked resolutions from the same IP in a short time: a likely
       sign of an infected machine trying to reach a C2/phishing domain
       already known to the filter, or of software that's very chatty
       with blocked telemetry/ads (expected noise, the triage AI will
       decide). -->
  <rule id="100852" level="7" frequency="20" timeframe="60" ignore="300">
    <if_matched_sid>100851</if_matched_sid>
    <same_field>IP</same_field>
    <description>AdGuard Home: many blocked DNS resolutions from $(IP) (potentially compromised machine).</description>
    <mitre>
      <id>T1071.004</id>
    </mitre>
  </rule>
</group>
