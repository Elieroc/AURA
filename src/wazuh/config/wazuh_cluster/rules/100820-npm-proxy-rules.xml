<!-- npm-access carries <type>web-log</type> to inherit native attack
     signatures (31101-31106, 31109, 31110: 4xx/5xx errors, SQLi, XSS, LFI,
     CGI/PHP) and the local rules already written on top of it
     (100700-100702, web,attack,web_attack_soc, — command injection, web
     shell, confirmed attack). Measured side effect: the native root rule
     31100 (<category>web-log</category>, unconditional on this decoder
     type) is ALWAYS selected before 100820 for the same event — two
     sibling root rules (no if_sid) on the same decoder, whichever loads
     first (ruleset before etc/rules) always wins. 100820 therefore never
     "wins" in practice; kept as a documentation anchor on decoded_as, not
     as a useful base for child rules. Consequence for index routing:
     wazuh-proxy-* tests decoder.name=='npm-access' in
     alerts-pipeline.json, NOT rule.groups containing npm-proxy (which
     would never be applied, since the rule that wins is native and
     doesn't carry that group). -->
<group name="local,npm-proxy,">
  <rule id="100820" level="0">
    <decoded_as>npm-access</decoded_as>
    <description>Nginx Proxy Manager access grouped.</description>
  </rule>

  <!-- Chained on the NATIVE rule (31101, "Web server 400 error code"), not
       on 100820: it's the one that wins in practice, see comment above.
       The 4xx/5xx errors themselves are already covered by the native
       rules (31101/31120) — no point duplicating them here, only the
       frequency brings new signal (probable scan). -->
  <rule id="100823" level="10" frequency="12" timeframe="60" ignore="120">
    <if_matched_sid>31101</if_matched_sid>
    <same_source_ip />
    <description>Nginx Proxy Manager: multiple client errors from same source (scan probable).</description>
    <mitre>
      <id>T1595</id>
    </mitre>
    <group>web_scan,</group>
  </rule>
</group>
