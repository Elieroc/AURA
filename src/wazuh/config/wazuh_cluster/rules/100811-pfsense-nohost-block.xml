<!--
  cf. 100810-pfsense-nohost-grouped.xml. no_log: like the native rule 87701,
  we don't want one alert per blocked packet (volume), only the abnormal
  frequency (100812).
-->
<group name="local,pfsense,">
  <rule id="100811" level="5">
    <if_sid>100810</if_sid>
    <action>block</action>
    <options>no_log</options>
    <description>pfSense firewall drop event (syslog without hostname).</description>
    <group>firewall_block,pfsense,</group>
  </rule>
</group>
