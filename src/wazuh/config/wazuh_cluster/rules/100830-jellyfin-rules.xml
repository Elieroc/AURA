<!--
  Jellyfin (Emby-based, embedded Kestrel) — no nginx, no structured HTTP
  log by default (verified: 0 requests logged). Serilog application log
  ingested as-is into its own index (wazuh-jellyfin-*, not wazuh-web-*):
  decoder decoders/jellyfin.xml extracts level (INF/WRN/ERR/FTL/DBG) +
  emitting class, useful for auth/errors even without visibility on
  individual HTTP requests.
-->
<group name="local,jellyfin,">
  <rule id="100830" level="0">
    <decoded_as>jellyfin</decoded_as>
    <description>Jellyfin log grouped.</description>
  </rule>

  <rule id="100831" level="5">
    <if_sid>100830</if_sid>
    <field name="level">^WRN$</field>
    <description>Jellyfin warning: $(class).</description>
  </rule>

  <rule id="100832" level="7">
    <if_sid>100830</if_sid>
    <field name="level">^ERR$</field>
    <description>Jellyfin error: $(class).</description>
  </rule>

  <rule id="100833" level="12">
    <if_sid>100830</if_sid>
    <field name="level">^FTL$</field>
    <description>Jellyfin fatal error: $(class).</description>
  </rule>
</group>
