{
  "index_patterns": [
    "wazuh-archive-*"
  ],
  "order": 1,
  "settings": {
    "index": {
      "number_of_shards": 1,
      "number_of_replicas": 0,
      "refresh_interval": "5s"
    }
  },
  "mappings": {
    "date_detection": false,
    "dynamic_templates": [
      {
        "strings_as_keyword": {
          "match_mapping_type": "string",
          "mapping": {
            "type": "keyword"
          }
        }
      }
    ],
    "properties": {
      "@timestamp": {
        "type": "date"
      },
      "timestamp": {
        "type": "date"
      },
      "event_type": {
        "type": "keyword"
      },
      "archive": {
        "properties": {
          "index_set": {
            "type": "keyword"
          },
          "period": {
            "type": "keyword"
          },
          "documents": {
            "type": "long"
          },
          "plain_bytes": {
            "type": "long"
          },
          "object_bytes": {
            "type": "long"
          },
          "ratio": {
            "type": "double"
          },
          "cost_usd_month": {
            "type": "double"
          },
          "archived_at": {
            "type": "date"
          },
          "verified_at": {
            "type": "date"
          },
          "verify_state": {
            "type": "keyword"
          },
          "verify_full": {
            "type": "boolean"
          },
          "object_lock_until": {
            "type": "date"
          }
        }
      }
    }
  }
}
