{
  "index_patterns": [
    "wazuh-ai-*"
  ],
  "order": 1,
  "settings": {
    "index": {
      "number_of_shards": 1,
      "number_of_replicas": 0,
      "refresh_interval": "5s"
    }
  },
  "mappings": {
    "date_detection": false,
    "dynamic_templates": [
      {
        "strings_as_keyword": {
          "match_mapping_type": "string",
          "mapping": {
            "type": "keyword"
          }
        }
      }
    ],
    "properties": {
      "@timestamp": {
        "type": "date"
      },
      "timestamp": {
        "type": "date"
      },
      "event_type": {
        "type": "keyword"
      },
      "ai": {
        "properties": {
          "usage": {
            "type": "keyword"
          },
          "model": {
            "type": "keyword"
          },
          "prompt_tokens": {
            "type": "long"
          },
          "completion_tokens": {
            "type": "long"
          },
          "total_tokens": {
            "type": "long"
          },
          "max_tokens": {
            "type": "long"
          },
          "duration_ms": {
            "type": "long"
          },
          "cost_usd": {
            "type": "double"
          },
          "ok": {
            "type": "boolean"
          },
          "error": {
            "type": "keyword"
          },
          "prompt_sha": {
            "type": "keyword"
          },
          "mode": {
            "type": "keyword"
          },
          "cache_hit_tokens": {
            "type": "long"
          },
          "cache_miss_tokens": {
            "type": "long"
          }
        }
      },
      "triage": {
        "properties": {
          "verdict": {
            "type": "keyword"
          },
          "confidence": {
            "type": "keyword"
          },
          "mitre": {
            "type": "keyword"
          },
          "actions": {
            "type": "keyword"
          },
          "action_count": {
            "type": "integer"
          },
          "incoherences": {
            "type": "keyword"
          },
          "incoherence_count": {
            "type": "integer"
          },
          "garde_fous": {
            "type": "keyword"
          },
          "garde_fou_count": {
            "type": "integer"
          },
          "injection_motifs": {
            "type": "keyword"
          },
          "injection_detected": {
            "type": "boolean"
          }
        }
      },
      "incident": {
        "properties": {
          "id": {
            "type": "long"
          },
          "agent_name": {
            "type": "keyword"
          },
          "max_level": {
            "type": "integer"
          },
          "alert_count": {
            "type": "integer"
          },
          "status": {
            "type": "keyword"
          },
          "priorite": {
            "type": "integer"
          },
          "severite": {
            "type": "integer"
          }
        }
      },
      "kpi": {
        "properties": {
          "mttd_minutes": {
            "type": "double"
          },
          "mttr_minutes": {
            "type": "double"
          },
          "mttr_total_minutes": {
            "type": "double"
          },
          "triage_minutes": {
            "type": "double"
          },
          "first_seen": {
            "type": "date"
          },
          "detected_at": {
            "type": "date"
          },
          "remediated_at": {
            "type": "date"
          },
          "remediated": {
            "type": "boolean"
          }
        }
      },
      "pipeline": {
        "properties": {
          "alerts_total": {
            "type": "long"
          },
          "alerts_suppressed": {
            "type": "long"
          },
          "incidents_total": {
            "type": "long"
          },
          "incidents_open": {
            "type": "long"
          },
          "triages_total": {
            "type": "long"
          },
          "whitelist_rules_active": {
            "type": "long"
          },
          "mitigations_executed": {
            "type": "long"
          },
          "labels_total": {
            "type": "long"
          }
        }
      }
    }
  }
}
