.env
.env.*
!.env.example
!*/.env.example
*.key
*.pem
*.srl
secrets/
wazuh/config/wazuh_cluster/wazuh_manager.conf

# Conf Aura-SOC (topologie reseau : IP manager, serveur de preuves)
config/soc-ai.conf
!config/soc-ai.conf.example
wazuh/config/wazuh_dashboard/wazuh.yml
wazuh/config/wazuh_indexer_ssl_certs/*
!wazuh/config/wazuh_indexer_ssl_certs/.gitkeep
__pycache__/
*.pyc
.venv/
venv/
node_modules/
.claude/
graphify-out/

# Serveur MCP Wazuh : entièrement hors dépôt (clone upstream + notre recette de
# déploiement et le patch d'active response). Ancré avec « / » : un motif « mcp/ »
# non ancré matcherait aussi iris/mcp/, qui reste versionné.
/mcp/

# Modèles GGUF et build llama.cpp : hors dépôt (~/.local/share/soc-ai/),
# le dépôt est synchronisé Nextcloud.
*.gguf
ai/bench/.server.log
ai/bench/.quality-server.log
ai/bench/.bench-stderr.log

# Environnement Python du soc-agent : hors dépôt (~/.local/share/soc-ai/venv)
.pytest_cache/

# Clone upstream du serveur MCP DFIR-IRIS (voir iris/mcp/README.md)
iris/mcp/iris-mcp/

# Overrides locaux à un hôte (ex: LXC Proxmox, limites memlock/nofile) —
# jamais versionnés, docker compose les merge automatiquement s'ils existent.
docker-compose.override.yml
