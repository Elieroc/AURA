.env
.env.*
!.env.example
!*/.env.example
*.key
*.pem
*.srl
secrets/
src/wazuh/config/wazuh_cluster/wazuh_manager.conf

# Conf Aura-SOC déployée hors dépôt sur agents/manager (topologie réseau : IP
# manager, serveur de preuves) — distincte du .env du manager docker compose.
/soc-ai.conf
!/soc-ai.conf.example
src/wazuh/config/wazuh_dashboard/wazuh.yml
src/wazuh/config/wazuh_indexer_ssl_certs/*
!src/wazuh/config/wazuh_indexer_ssl_certs/.gitkeep

# Bases de données du projet (Postgres soc-agent/IRIS, OpenSearch Shuffle/Wazuh) :
# bind mounts hôte, jamais versionnées.
/db/*
!/db/*/.gitkeep

__pycache__/
*.pyc
.venv/
venv/
node_modules/
.claude/
graphify-out/

# Serveur MCP Wazuh : entièrement hors dépôt (clone upstream + notre recette de
# déploiement et le patch d'active response). Ancré avec « / » : un motif « mcp/ »
# non ancré matcherait aussi iris/mcp/, qui reste versionné.
/mcp/

# Modèles GGUF et build llama.cpp : hors dépôt (~/.local/share/soc-ai/),
# le dépôt est synchronisé Nextcloud.
*.gguf
src/ai/bench/.server.log
src/ai/bench/.quality-server.log
src/ai/bench/.bench-stderr.log

# Environnement Python du soc-agent : hors dépôt (~/.local/share/soc-ai/venv)
.pytest_cache/

# Clone upstream du serveur MCP DFIR-IRIS (voir src/iris/mcp/README.md)
src/iris/mcp/iris-mcp/

# Overrides locaux à un hôte (ex: LXC Proxmox, limites memlock/nofile) —
# jamais versionnés, docker compose les merge automatiquement s'ils existent.
docker-compose.override.yml

# Contexte projet Claude Code : contient des détails propres au lab de l'auteur
# (topologie, hôtes, historique d'incidents). Reste en local, jamais publié.
CLAUDE.md
