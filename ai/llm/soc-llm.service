# Serveur d'inférence local du SOC (llama.cpp).
#
# Installation en service utilisateur :
#   mkdir -p ~/.config/systemd/user
#   cp ai/llm/soc-llm.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now soc-llm
#   systemctl --user status soc-llm
#
# Vérification :
#   curl -s http://127.0.0.1:8081/health
#
# Le binaire et le modèle vivent dans ~/.local/share/soc-ai/ : le dépôt est
# synchronisé Nextcloud, on n'y met pas 5 Go de poids ni un build natif.

[Unit]
Description=SOC-AI — serveur d'inference llama.cpp
After=network.target

[Service]
Type=exec

# -t 8 : les coeurs physiques. Le SMT dégrade l'inference (les deux threads
#        d'un coeur se disputent les mêmes unités vectorielles).
# -c 4096 : au-delà de notre plafond de contexte, avec de la marge pour le
#        cache de plusieurs slots.
# --parallel 2 : deux requêtes concurrentes suffisent (quelques incidents par
#        heure) et chaque slot garde son propre préfixe en cache.
# --host 127.0.0.1 : le modèle ne doit jamais être joignable depuis le réseau.
ExecStart=%h/.local/share/soc-ai/llama.cpp/build/bin/llama-server \
    --model %h/.local/share/soc-ai/models/Qwen3-8B-Q4_K_M.gguf \
    --threads 8 \
    --ctx-size 4096 \
    --parallel 2 \
    --host 127.0.0.1 \
    --port 8081

# Priorité basse et plafond CPU : le manager Wazuh ne doit jamais rater une
# alerte parce que le modèle réfléchit. L'analyse Wazuh est elle aussi
# CPU-bound et passe avant.
Nice=10
CPUWeight=20
CPUQuota=600%

# Le serveur ne lit que son modèle et n'écrit nulle part.
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
NoNewPrivileges=true
PrivateDevices=true
RestrictAddressFamilies=AF_INET AF_UNIX

Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
