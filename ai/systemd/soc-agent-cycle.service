# Un cycle du pipeline SOC : ingest -> correlate -> triage.
#
# Service oneshot, déclenché par soc-agent-cycle.timer. Ne pas l'activer
# directement (enable) : c'est le timer qu'on active.
#
# Installation (service utilisateur, comme soc-llm) :
#   mkdir -p ~/.config/systemd/user
#   cp ai/systemd/soc-agent-cycle.{service,timer} ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now soc-agent-cycle.timer
#
# Suivi :
#   systemctl --user list-timers soc-agent-cycle.timer
#   journalctl --user -u soc-agent-cycle.service -f
#   systemctl --user start soc-agent-cycle.service   # forcer un cycle tout de suite

[Unit]
Description=SOC-AI — un cycle ingest/correlate/triage
# Le triage a besoin du serveur d'inférence. Wants (et pas Requires) : si le
# LLM est absent, le cycle tourne quand même — ingest et correlate ont de la
# valeur seuls, et cycle.py saute proprement le triage.
Wants=soc-llm.service
After=soc-llm.service network-online.target

[Service]
Type=oneshot

# Répertoire du paquet soc_agent, et son .env (secrets base + indexer).
# %h = home de l'utilisateur. À adapter si le dépôt est ailleurs.
WorkingDirectory=%h/Nextcloud/Documents/IT/Projets/SOC-AI/ai
EnvironmentFile=%h/Nextcloud/Documents/IT/Projets/SOC-AI/ai/.env

ExecStart=%h/.local/share/soc-ai/venv/bin/python -m soc_agent.cycle

# Un cycle ne doit pas traîner indéfiniment (serveur LLM qui pend, indexer
# lent). Au-delà, on tue et on retentera au prochain déclenchement.
TimeoutStartSec=1800

# Le triage est déjà bridé par le CPUQuota de soc-llm ; ici on baisse juste la
# priorité de l'orchestrateur lui-même.
Nice=10
