# Déclenche le traitement des tâches IRIS WHITELIST toutes les minutes.
#
# 1 min : quand l'analyste passe une tâche WHITELIST en 'To do', il attend une
# réponse (exception créée ou question) rapidement, pas au prochain cycle de
# triage (5 min). Le passage est bon marché quand il n'y a rien à traiter (un
# SELECT + un list_tasks IRIS par case concerné). Le verrou consultatif dans
# whitelist_task.traiter empêche deux passages de se superposer.
#
# Pour changer la cadence : éditer OnUnitActiveSec, puis
#   systemctl --user daemon-reload && systemctl --user restart soc-agent-whitelist-task.timer

[Unit]
Description=SOC-AI — déclenche le traitement des tâches whitelist périodiquement

[Timer]
# Premier passage 1 min après le démarrage de session, puis toutes les minutes.
OnStartupSec=1min
OnUnitActiveSec=1min
# Rattrape un déclenchement manqué (machine en veille) dès le réveil.
Persistent=true
RandomizedDelaySec=5

[Install]
WantedBy=timers.target
