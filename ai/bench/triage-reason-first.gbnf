# Variante de triage.gbnf : reason AVANT verdict.
#
# Dans triage.gbnf le modèle doit émettre "verdict" en premier token utile,
# donc trancher avec zéro token de raisonnement derrière lui. Ici, l'ordre des
# champs oblige à écrire l'analyse d'abord : le JSON sert lui-même de chaîne de
# raisonnement, et le verdict est échantillonné avec cette analyse déjà dans le
# contexte.
#
# Coût : identique (mêmes tokens générés). C'est purement un ordre de champs.

root ::= (
    "{" ws
        "\"reason\":"      ws reason     "," ws
        "\"mitre\":"       ws mitre      "," ws
        "\"verdict\":"     ws verdict    "," ws
        "\"confidence\":"  ws confidence "," ws
        "\"next_action\":" ws action     ws
    "}"
)

verdict ::= "\"true_positive\"" | "\"false_positive\"" | "\"needs_investigation\""

confidence ::= "\"low\"" | "\"medium\"" | "\"high\""

mitre ::= "null" | "\"T" [0-9] [0-9] [0-9] [0-9] ("." [0-9] [0-9] [0-9])? "\""

action ::= (
    "\"close_false_positive\"" |
    "\"open_case\"" |
    "\"collect_endpoint_evidence\"" |
    "\"propose_block_ip\"" |
    "\"propose_isolate_host\"" |
    "\"escalate_human\""
)

reason ::= "\"" char{20,320} "\""

char ::= [^"\\\x7F\x00-\x1F] | "\\" (["\\bfnrt] | "u" [0-9a-fA-F]{4})
ws ::= [ \t\n]*
