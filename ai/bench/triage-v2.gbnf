# Grammaire de triage v2.
#
# Deux changements par rapport à triage-reason-first.gbnf :
#
#   1. `actions` est une LISTE. Une compromission réelle appelle plusieurs
#      propositions à la fois — couper l'IP, isoler l'hôte, désactiver le
#      compte — et un champ scalaire forçait le modèle à en sacrifier deux.
#   2. `propose_disable_user` s'ajoute à l'enum : sur un compte compromis, ni
#      le blocage d'IP ni l'isolation ne traitent le fait que l'attaquant
#      détient des identifiants valides.
#
# `reason` reste en premier : le modèle doit avoir écrit son analyse avant
# d'échantillonner le verdict (cf. RESULTS.md).
#
# L'enum reste fermée et les actions restent des PROPOSITIONS : rien ne
# s'exécute sans passer par la validation de l'orchestrateur.

root ::= (
    "{" ws
        "\"reason\":"     ws reason     "," ws
        "\"mitre\":"      ws mitre      "," ws
        "\"verdict\":"    ws verdict    "," ws
        "\"confidence\":" ws confidence "," ws
        "\"actions\":"    ws actions    ws
    "}"
)

verdict ::= "\"true_positive\"" | "\"false_positive\"" | "\"needs_investigation\""

confidence ::= "\"low\"" | "\"medium\"" | "\"high\""

mitre ::= "null" | "\"T" [0-9] [0-9] [0-9] [0-9] ("." [0-9] [0-9] [0-9])? "\""

# Une à quatre actions. Le plafond évite qu'un modèle hésitant ne coche tout
# l'inventaire, ce qui reviendrait à ne rien décider.
actions ::= "[" ws action (ws "," ws action){0,3} ws "]"

action ::= (
    "\"close_false_positive\"" |
    "\"open_case\"" |
    "\"collect_endpoint_evidence\"" |
    "\"propose_block_ip\"" |
    "\"propose_isolate_host\"" |
    "\"propose_disable_user\"" |
    "\"escalate_human\""
)

reason ::= "\"" char{20,320} "\""

char ::= [^"\\\x7F\x00-\x1F] | "\\" (["\\bfnrt] | "u" [0-9a-fA-F]{4})
ws ::= [ \t\n]*
