# Configuration du soc-agent — copier en .env et remplir.
#   cp .env.example .env
# .env est gitignored.

# --- Base du soc-agent ------------------------------------------------------
# openssl rand -hex 24
PGPASSWORD=__CHANGE_ME__
PGUSER=socagent
PGDATABASE=socagent
PGPORT=5433

# --- Indexer Wazuh (source des alertes) -------------------------------------
# Même valeur que INDEXER_PASSWORD dans wazuh/.env.
INDEXER_PASSWORD=__CHANGE_ME__
INDEXER_URL=https://127.0.0.1:9200
INDEXER_USER=admin
# Certificats auto-signés sur la loopback. Passer à true (avec INDEXER_CA)
# dès que l'indexer n'est plus joint en local.
INDEXER_VERIFY_TLS=false
#INDEXER_CA=/chemin/vers/root-ca.pem

# --- Filtrage ---------------------------------------------------------------
# Niveau Wazuh minimal envoyé au triage. 12 = seuil "high" (12-14 high, 15
# critical). En dessous, l'alerte est stockée pour les statistiques seulement.
MIN_LEVEL=12
ATTACH_MIN_LEVEL=3
# Niveau minimal à ingérer. 0 = tout stocker, ce qui donne les statistiques
# complètes de l'entonnoir. Monter à MIN_LEVEL une fois la mesure faite.
INGEST_MIN_LEVEL=0

# --- Rattrapage des alertes indexées en retard -------------------------------
# Le curseur d'ingestion avance sur la date de l'ÉVÉNEMENT, pas sur celle de son
# indexation : toute alerte devenue visible après le passage du curseur serait
# sautée définitivement.
# Recul de sécurité à chaque reprise, couvre le skew agent->manager->indexer.
INGEST_LOOKBACK_MINUTES=15
# Balayage complet périodique, indépendant du curseur : récupère les logs qu'un
# agent déconnecté rejoue à la reconnexion avec leur horodatage d'origine.
# 48 h couvre une coupure de week-end.
INGEST_SWEEP_HOURS=48
INGEST_SWEEP_INTERVAL_MINUTES=60

# --- DeepSeek (API cloud, compatible OpenAI) --------------------------------
# Clé depuis platform.deepseek.com > API Keys. Donne accès au crédit payant :
# jamais en clair dans le repo. Les données SOC doivent être anonymisées avant
# tout appel (cf. sanitize.py).
DEEPSEEK_API_KEY=__CHANGE_ME__
DEEPSEEK_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# --- Remédiation (exécution des actions) ------------------------------------
# false = DRY-RUN (montre, n'agit pas). true = exécute réellement sur la prod.
MITIGATE_EXECUTE=false
SHUFFLE_URL=http://localhost:5001
SHUFFLE_WEBHOOK_ISOLATE=webhook_00000000-0000-0000-0000-00000000a001
SHUFFLE_WEBHOOK_KILL=webhook_00000000-0000-0000-0000-00000000a002
# API Wazuh (blocage IP, désactivation compte). Password = API_PASSWORD de wazuh/.env.
WAZUH_API_URL=https://127.0.0.1:55000
WAZUH_API_USER=wazuh-wui
WAZUH_API_PASSWORD=__CHANGE_ME__

# --- Corrélation ------------------------------------------------------------
# Fenêtre pour les liens faibles (tactique MITRE, groupe de règle).
CORRELATION_GAP_MINUTES=30
# Fenêtre pour les liens forts (même IP, même fichier, même compte).
ENTITY_GAP_MINUTES=360
MAX_INCIDENT_HOURS=6

# --- Pivot vers le dashboard Wazuh (deep-links des rapports) ----------------
# URL ouverte depuis le NAVIGATEUR de l'analyste, pas depuis cet hôte : ne
# jamais laisser « localhost » (le lien pointerait sur la machine de l'analyste).
WAZUH_DASHBOARD_URL=https://192.168.10.5
# WAZUH_DASHBOARD_DISCOVER_PATH=/app/data-explorer/discover
# WAZUH_DASHBOARD_INDEX_PATTERN=soc-ai-all-alerts

# --- Sous-réseaux internes du parc (qualification des IOC IP) ----------------
# Une IP source ou cible /dev/tcp DANS ces plages = mouvement latéral interne,
# PAS un C2. NE PAS mettre 10.0.0.0/8 en bloc : le C2 du lab y vit. Lister les
# subnets réellement internes.
RESEAUX_INTERNES=192.168.20.0/24,192.168.10.0/24,192.168.40.0/24

# --- DFIR-IRIS (case management) --------------------------------------------
IRIS_URL=https://127.0.0.1:8443
# Clé d'API IRIS : même valeur que IRIS_ADM_API_KEY dans iris/.env.
IRIS_API_KEY=__CHANGE_ME__
IRIS_VERIFY_TLS=false
IRIS_CUSTOMER=1

# --- Réglage automatique des règles Wazuh (soc-agent-rule-tuning) -----------
# Génère des règles filles d'exception à partir des FP récurrents, pour que le
# bruit soit écarté DANS le moteur de règles (cf. rule_tuning.py). Chaque règle
# est prouvée par rejeu /logtest avant d'être conservée, contre-exemple compris.
# Répertoire de règles du manager, tel que monté sur l'hôte.
WAZUH_RULES_DIR=../wazuh/config/wazuh_cluster/rules
# Niveau appliqué par l'exception. 5 = on abaisse (l'alerte reste lisible mais
# n'ouvre plus d'incident). 0 = suppression totale, exige le drapeau ci-dessous.
RULE_TUNING_NIVEAU=5
RULE_TUNING_AUTORISE_NIVEAU_0=false
RULE_TUNING_MAX_REGLES=50

# --- Métriques d'IA (soc-agent-metrics -> index wazuh-ai-*) ------------------
# Fenêtre réexportée à chaque passage. L'export est idempotent (_id
# déterministe) : un recouvrement large rattrape une panne d'indexer.
METRICS_FENETRE=6h
# Tarifs du modèle, en USD par million de tokens. Défauts = grille publique de
# deepseek-v4-flash relevée le 2026-07-29. APPROXIMATIF : relevé sur la grille
# publiée, pas sur une facture. Recoupé sur la conso réelle du compte
# (671 593 tokens pour 0,09 USD). Bon ordre de grandeur, pas de la refacturation.
# Le cache hit est 50x moins cher : la ventilation est lue dans la réponse de
# l'API quand elle existe, sinon tout est compté en cache miss (estimation haute).
LLM_COUT_USD_PAR_MTOKEN_IN=0.14
LLM_COUT_USD_PAR_MTOKEN_IN_CACHE=0.0028
LLM_COUT_USD_PAR_MTOKEN_OUT=0.28
