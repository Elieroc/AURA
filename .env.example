# Configuration AURA — copier en .env et remplir.
#   cp .env.example .env
# .env est gitignored. Générer chaque secret séparément : openssl rand -hex 32
#
# Sommaire :
#   WAZUH · SOC-AGENT · MISP/CTI · HUNTING · ARCHIVAGE · IRIS · SHUFFLE
#   · MCP AURA · TOPOLOGIE HORS DÉPÔT


# ============================================================================
# WAZUH
# ============================================================================

# --- Indexer ---
# Le hachage bcrypt correspondant vit dans
# src/wazuh/config/wazuh_indexer/internal_users.yml : les deux doivent être
# régénérés ENSEMBLE, sinon plus rien ne s'authentifie.
#   python3 scripts/set-indexer-password.py admin
INDEXER_PASSWORD=__CHANGE_ME__
INDEXER_URL=https://127.0.0.1:9200
INDEXER_USER=admin
# Certificats auto-signés sur la loopback. true (avec INDEXER_CA) dès que
# l'indexer n'est plus joint en local.
INDEXER_VERIFY_TLS=false
#INDEXER_CA=/chemin/vers/root-ca.pem

# --- Dashboard ---
# Compte de service avec lequel le dashboard interroge l'indexer. Même
# procédure que ci-dessus : python3 scripts/set-indexer-password.py kibanaserver
DASHBOARD_PASSWORD=__CHANGE_ME__

# URL ouverte depuis le NAVIGATEUR de l'analyste (deep-links des rapports IRIS),
# pas depuis cet hôte : jamais « localhost ».
WAZUH_DASHBOARD_URL=https://__IP_OU_NOM_DU_MANAGER__
# WAZUH_DASHBOARD_DISCOVER_PATH=/app/data-explorer/discover
# WAZUH_DASHBOARD_INDEX_PATTERN=soc-ai-all-alerts

# --- API du manager ---
# Consommée par wazuh.manager/dashboard ET par soc-agent (blocage IP,
# désactivation de compte). Règle Wazuh : 8+ car., maj/min/chiffre/spécial.
WAZUH_API_URL=https://127.0.0.1:55000
WAZUH_API_USER=wazuh-wui
WAZUH_API_PASSWORD=changeme

# --- Enrichissement threat intel ---
# À reporter aussi dans src/wazuh/config/wazuh_cluster/wazuh_manager.conf.
WAZUH_VT_API_KEY=changeme
WAZUH_ABUSEIPDB_API_KEY=changeme


# ============================================================================
# SOC-AGENT (pipeline IA)
# ============================================================================

# --- Base Postgres ---
# openssl rand -hex 24
PGPASSWORD=__CHANGE_ME__
PGUSER=socagent
PGDATABASE=socagent
PGPORT=5433

# --- Ingestion et filtrage ---
# Niveau Wazuh minimal envoyé au triage (12-14 high, 15 critical). En dessous,
# l'alerte est stockée pour les statistiques seulement.
MIN_LEVEL=12
ATTACH_MIN_LEVEL=3
# Niveau minimal à ingérer. 0 = tout stocker (entonnoir complet).
INGEST_MIN_LEVEL=0

# Le curseur d'ingestion avance sur la date de l'ÉVÉNEMENT, pas sur celle de son
# indexation : une alerte visible après le passage du curseur serait sautée
# définitivement. D'où le recul de sécurité à chaque reprise (skew
# agent->manager->indexer) et le balayage complet périodique, qui récupère les
# logs qu'un agent déconnecté rejoue à la reconnexion. 48 h couvre un week-end.
INGEST_LOOKBACK_MINUTES=15
INGEST_SWEEP_HOURS=48
INGEST_SWEEP_INTERVAL_MINUTES=60

# --- Modèle (DeepSeek, API compatible OpenAI) ---
# Clé depuis platform.deepseek.com > API Keys : jamais en clair dans le repo.
# Les données SOC sont anonymisées avant tout appel (cf. sanitize.py).
DEEPSEEK_API_KEY=__CHANGE_ME__
DEEPSEEK_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# --- Filtre VirusTotal des exécutables (vt.py) ---
# Même valeur que WAZUH_VT_API_KEY. Sans elle, le filtre est inactif : moins de
# filtrage, aucune suppression.
VT_API_KEY=changeme

# --- Corrélation ---
# Liens faibles (tactique MITRE, groupe de règle) / liens forts (même IP, même
# fichier, même compte).
CORRELATION_GAP_MINUTES=30
ENTITY_GAP_MINUTES=360
MAX_INCIDENT_HOURS=6
# Fusion CAMPAGNE : incidents de plusieurs hôtes réunis en un seul case s'ils
# partagent un marqueur d'attaquant. 0 = désactive.
CAMPAGNE_GAP_HOURS=48

# Une IP source ou cible DANS ces plages = mouvement latéral interne, PAS un C2.
# NE PAS mettre 10.0.0.0/8 en bloc si une partie est routée vers l'extérieur
# (VPN, cloud privé). Ex : RESEAUX_INTERNES=10.20.0.0/16
RESEAUX_INTERNES=

# --- CMDB : priorité des assets (cf. docs/CMDB.md) ---
# Le rôle d'une machine est porté par un groupe Wazuh préfixé (role-dc,
# role-web…) ; il fixe sa priorité P1-P4, donc l'ordre d'analyse et la sévérité
# effective de ses incidents.
CMDB_GROUPE_PREFIXE=role-

# Rôles supplémentaires ou reclassés, format role=priorite, virgules. Défaut :
# dc/firewall/soc/hypervisor/pki/backup (P1), web/db/mail/proxy/dns/vpn/
# fileserver (P2), serveur/admin (P3), endpoint/lab (P4).
PRIORITE_ROLES=

# Priorité d'un rôle non déclaré. P4 : ce qui n'est pas déclaré ne prend pas la
# place de ce qui l'est. Contrepartie à surveiller avec
# `python -m soc_agent.assets --couverture`.
PRIORITE_DEFAUT=4

# Décalage du niveau Wazuh pour la sévérité effective, ordre P1,P2,P3,P4.
# `max_level` n'est jamais modifié.
SEVERITE_BONUS_PRIORITE=2,1,0,-1

# Niveau à partir duquel le modèle ne peut plus clore en faux positif.
CLOTURE_INTERDITE_PAR_PRIORITE=12,13,14,14

# Priorité rabattue pour les AGENTS_CAPTEURS (cf. remédiation) : sans elle,
# chaque alerte remontée par le pare-feu (P1) noierait la file d'incidents P1.
PRIORITE_CAPTEUR=3

# --- Remédiation (exécution des actions) ---
# false = DRY-RUN (montre, n'agit pas). true = exécute réellement sur la prod.
# Canaux : Shuffle (isolation/kill) et API Wazuh, cf. leurs sections.
MITIGATE_EXECUTE=false

# Agents capteurs : leur télémétrie décrit d'AUTRES machines — capteur d'hôte
# (l'auditd d'un Proxmox voit les execve de ses conteneurs) ou capteur réseau
# (Suricata/filterlog d'une passerelle décrivent le trafic du parc). Une
# remédiation ne les vise JAMAIS. Id d'agents Wazuh, virgules.
AGENTS_CAPTEURS=

# Agents Windows : isolation/blocage/kill/désactivation partent sur les scripts
# Windows/AD au lieu des .sh Linux. Id d'agents Wazuh, virgules.
AGENTS_WINDOWS=

# Contrôleurs de domaine : exécuteurs des actions de domaine (désactiver un
# compte AD, retirer d'un groupe). Id d'agents Wazuh, virgules.
AGENTS_DC=

# IP(s) que l'isolation d'un hôte Windows laisse joignables (le manager Wazuh).
MITIGATE_ISOLATE_ALLOW=

# IP de l'infra SOC qui ne sont NI un IOC NI une cible de blocage. Manager,
# indexer, IRIS et Shuffle sont déjà déduits des URL configurées et de
# MITIGATE_ISOLATE_ALLOW : ne remplir que le reste (VIP, seconde interface du
# manager, collecteur tiers). Virgules.
SOC_INFRA_IPS=

# --- Mode training (soc-training) ---
# Fenêtre d'apprentissage du bruit ambiant à la mise en service sur un SI déjà
# en production. Pendant la fenêtre le pipeline d'analyse est SUSPENDU (pas de
# triage LLM, pas de case, pas de remédiation) : seule l'ingestion tourne, et
# chaque alerte HIGH/CRITICAL observée devient une exception de whitelist propre
# à sa machine. À la clôture, un case IRIS « TRAINING » liste chaque exception
# en tâche ; passer une tâche en 'Canceled' désactive l'exception.
#
# ATTENTION : une intrusion en cours au lancement serait apprise comme du bruit.
# N'activer que sur un SI qu'on croit sain, et relire le case TRAINING à la fin.
# N'ouvre une fenêtre qu'au TOUT PREMIER démarrage ; pour en rouvrir une :
#   docker exec soc-training python -m soc_agent.training --demarrer --jours 7
TRAINING_ENABLED=false
TRAINING_DAYS=7
# Bornes de niveau appris. Le plafond couvre CRITICAL exprès : c'est le niveau
# qui déclenche les remédiations les plus coûteuses.
TRAINING_MIN_LEVEL=12
TRAINING_MAX_LEVEL=15

# --- UEBA (alertes LOW/MEDIUM) ---
# Le pipeline n'ouvre un incident qu'à partir du niveau 12 : en dessous, tout est
# ingéré mais rien ne graine, et une intrusion discrète reste invisible. UEBA
# construit une baseline par machine et par compte, score la RARETÉ, et promeut
# les concentrations les mieux notées. Zéro token : le moteur classe, le LLM
# garde le verdict VP/FP en bout de chaîne.
#   docker exec soc-agent-cycle python -m soc_agent.ueba --etat
UEBA_ENABLED=true

# Maturité d'un profil : sous ce seuil, le scope est OBSERVÉ mais jamais scoré.
# Le premier jour tout est inédit — scorer enverrait le parc entier au LLM.
UEBA_MATURITE_JOURS=7
UEBA_MATURITE_MIN_OBS=200

# LE garde-fou de coût. Un seuil de score seul ne borne rien (le volume varie
# d'un facteur dix) ; le budget est un nombre qu'on décide. Un signal non promu
# est réévalué au cycle suivant, avec un score qui a grossi s'il continue.
UEBA_BUDGET_JOUR=20
UEBA_BUDGET_PAR_CYCLE=2

# Score minimal de promotion. À CALIBRER sur données réelles avant de le durcir,
# sans consommer un token :
#   docker exec soc-agent-cycle python -m soc_agent.ueba --simulation
# puis lire les scores dans la table `ueba_signals`.
UEBA_SCORE_PLANCHER=35

# Remédiation autonome sur un incident d'origine UEBA. FALSE délibérément : le
# reste du pipeline part d'une règle Wazuh >= 12, un incident UEBA part d'un
# score statistique dont la justesse n'est pas mesurée. Le verdict est rendu, le
# case créé avec les actions proposées, rien n'est exécuté.
UEBA_MITIGATE=false

# --- Réglage automatique des règles Wazuh (soc-agent-rule-tuning) ---
# Génère des règles filles d'exception à partir des FP récurrents (rule_tuning.py)
# pour écarter le bruit DANS le moteur de règles. Chaque règle est prouvée par
# rejeu /logtest, contre-exemple compris.
# Répertoire de règles du manager, tel que monté sur l'hôte, relatif à la racine.
WAZUH_RULES_DIR=./src/wazuh/config/wazuh_cluster/rules
# Niveau appliqué par l'exception. 5 = l'alerte reste lisible mais n'ouvre plus
# d'incident. 0 = suppression totale, exige le drapeau ci-dessous.
RULE_TUNING_NIVEAU=5
RULE_TUNING_AUTORISE_NIVEAU_0=false
RULE_TUNING_MAX_REGLES=50

# --- Métriques d'IA (soc-agent-metrics -> index wazuh-ai-*) ---
# Fenêtre réexportée à chaque passage. L'export est idempotent (_id
# déterministe) : un recouvrement large rattrape une panne d'indexer.
METRICS_FENETRE=6h
# Tarifs du modèle, USD par million de tokens. Défauts = grille publique de
# deepseek-v4-flash au 2026-07-29, recoupée sur la conso réelle du compte
# (671 593 tokens pour 0,09 USD) : bon ordre de grandeur, pas de la
# refacturation. Le cache hit est 50x moins cher ; la ventilation est lue dans
# la réponse de l'API quand elle existe, sinon tout est compté en cache miss.
LLM_COUT_USD_PAR_MTOKEN_IN=0.14
LLM_COUT_USD_PAR_MTOKEN_IN_CACHE=0.0028
LLM_COUT_USD_PAR_MTOKEN_OUT=0.28

# --- VOC : gestion des vulnérabilités (soc-agent-vulns, cf. docs/VOC.md) ---
# Le module Vulnerability Detection de Wazuh écrit dans un index d'ÉTAT : le
# document d'une vulnérabilité corrigée est SUPPRIMÉ. Sans le journal tenu par
# soc_agent.vulns, il n'existe ni burn-down, ni MTTR, ni suivi de SLA.
VULN_INDICES=wazuh-states-vulnerabilities-*
VOC_INDEX_PREFIX=wazuh-voc

# Multiplicateur de risque par priorité CMDB, ordre P1,P2,P3,P4.
VOC_FACTEUR_PRIORITE=4,2,1,0.5

# Charge pondérée qui vaut 100/100. Score log-compressé ; à relever si le parc
# sature à 100 (le score ne trie alors plus rien).
VOC_CHARGE_MAX=20000

# Délais de correction attendus, en jours : `severite:P1,P2,P3,P4`, séparés par
# des points-virgules. Vide = défauts (critical 7/14/30/60, high 15/30/60/90,
# medium 30/60/90/180, low 90/180/365/365). Objectifs de service, pas une norme :
# leur seule fonction est de rendre le retard mesurable.
VOC_SLA_JOURS=

# Sévérités exportées vulnérabilité par vulnérabilité. Les Low/Medium se comptent
# par milliers et restent dans les agrégats.
VOC_SEVERITES_DETAIL=critical,high

# CVE listées nommément dans la section « Exposition aux vulnérabilités » d'un
# case IRIS.
VOC_MAX_CVE_RAPPORT=10

# --- Rétention des données (soc-agent-retention, cf. docs/RETENTION.md) ---
# Ces bornes JETTENT de la donnée, et c'est leur raison d'être : le 2026-08-14 la
# prod était à 66 % de disque sans qu'aucune politique n'existe.

# Alertes Postgres. Celles d'un incident encore actif sont épargnées quel que
# soit leur âge : un dossier ouvert ne se vide pas tout seul.
RETENTION_ALERTES_JOURS=90

# Index datés de l'indexer (politique ISM « aura-retention »). `wazuh-voc-vulns`
# en est exclu par construction : index d'état non daté, il porte le MTTR.
RETENTION_INDEX_JOURS=90

# Résidus de mise à jour du feed CVE de Wazuh. En HEURES, et large : garantit
# qu'on ne supprime pas les fichiers d'une mise à jour EN COURS.
RETENTION_VD_TMP_HEURES=12

# Pose de la politique ISM à chaque passage. false seulement si la rétention des
# index est gérée ailleurs.
RETENTION_ISM_ENABLED=true


# ============================================================================
# MISP / CTI (cf. docs/CTI.md)
# ============================================================================
#
# MISP tient la mémoire (feeds, événements, contexte), soc-agent-cti en extrait
# un cache d'IOC, et l'intégration custom-misp du manager confronte chaque alerte
# à ce cache (règles 100950-100956). Feeds : src/ai/soc_agent/cti_feeds.yaml.

# --- Accès ---
# URL utilisée par le soc-agent comme CLIENT d'API. Elle doit désigner l'adresse
# OÙ LE PORT EST PUBLIÉ, donc suivre MISP_BIND_ADDR : viser la loopback alors que
# le bind est sur l'IP d'administration donne un « Connection refused » (mesuré
# en prod le 2026-08-12). JAMAIS l'URL publique du reverse proxy : le pipeline
# CTI n'a pas à dépendre du proxy et du DNS pour un service local.
MISP_URL=https://127.0.0.1:8444

# URL vue par le NAVIGATEUR (BASE_URL de MISP) : liens, cookies, redirections.
# Derrière un reverse proxy, mettre l'URL PUBLIQUE du proxy — sinon MISP renvoie
# vers l'adresse du conteneur et l'authentification échoue sans message clair.
# Vide = même valeur que MISP_URL.
MISP_BASE_URL=https://127.0.0.1:8444

# Interface d'écoute du port publié. 127.0.0.1 = machine seule (tunnel SSH pour
# l'UI) ; l'IP d'administration pour placer un reverse proxy devant ; 0.0.0.0
# expose sur TOUTES les interfaces. Ce qu'on ouvre en publiant : la clé d'API
# vaut lecture ET écriture sur tout le renseignement, le certificat est
# auto-signé, et une instance MISP dit ce que le SOC cherche — donc, en creux,
# ce qu'il ne cherche pas.
MISP_BIND_ADDR=127.0.0.1
MISP_HTTPS_PORT=8444

# Certificat auto-signé généré au premier démarrage. true dès que MISP n'est plus
# sur la loopback.
MISP_VERIFY_TLS=false

# Reverse proxy devant MISP : sans ces deux variables, toutes les connexions sont
# journalisées avec l'IP du proxy, donc plus aucune traçabilité de qui consulte
# le renseignement. MISP_REAL_IP_FROM = IP du proxy, virgules.
MISP_X_FORWARDED_FOR=false
MISP_REAL_IP_FROM=

# --- Comptes et secrets ---
# Clé d'API de l'admin, POSÉE PAR NOUS (40 car.) plutôt que tirée au sort par
# MISP : sinon il faudrait la relire dans l'UI après chaque recréation du
# conteneur. Vaut lecture ET écriture sur tout le renseignement.
#   openssl rand -hex 20
MISP_KEY=__CHANGE_ME__

MISP_ADMIN_EMAIL=admin@aura.local
MISP_ADMIN_PASSWORD=__CHANGE_ME__
MISP_ADMIN_ORG=AURA

# ENCRYPTION_KEY chiffre les identifiants stockés en base (clés des serveurs de
# synchronisation) : la CHANGER après coup rend illisible ce qui est déjà
# chiffré. openssl rand -hex 32 pour les deux.
MISP_ENCRYPTION_KEY=__CHANGE_ME__
MISP_GPG_PASSPHRASE=__CHANGE_ME__

MISP_DB_NAME=misp
MISP_DB_USER=misp
MISP_DB_PASSWORD=__CHANGE_ME__
MISP_DB_ROOT_PASSWORD=__CHANGE_ME__
MISP_REDIS_PASSWORD=__CHANGE_ME__

# --- Conteneurs ---
# Versions épinglées : `latest` sur une brique qui applique des migrations de
# schéma au démarrage, c'est accepter une montée de version non choisie au
# prochain `docker compose pull`.
MISP_CORE_TAG=v2.5.44
MISP_MODULES_TAG=v3.0.9

# 2048M de PHP + 512M d'InnoDB tiennent sur la machine du lab ; monter
# INNODB_BUFFER_POOL_SIZE au-delà de quelques centaines de milliers d'attributs.
MISP_PHP_MEMORY_LIMIT=2048M
MISP_INNODB_BUFFER_POOL_SIZE=512M

# --- Cache d'IOC (soc-agent-cti -> intégration custom-misp) ---
# Chemin CÔTÉ PRODUCTEUR. Le manager le voit en lecture seule sous
# /var/ossec/integrations/cti/ioc.db (volume docker `aura_cti_ioc`).
CTI_CACHE=/var/lib/aura-cti/ioc.db

# Profondeur de l'extraction MISP, au sens du paramètre `last` de son API : date
# de dernière MODIFICATION de l'attribut, PAS l'âge du renseignement. Au premier
# import cette fenêtre ne filtre presque rien — son rôle est d'éviter de retirer
# tout le corpus à chaque passe.
CTI_FENETRE=90d

# Âge max de l'ÉVÉNEMENT d'origine pour retenir une IP (0 = pas de filtre). C'est
# ÇA, le filtre de fraîcheur : une IP publiée comme C2 en 2015 est aujourd'hui un
# hébergeur mutualisé, la garder c'est s'offrir des alertes 12-14 sur du trafic
# légitime signées « CIRCL ». IP seulement — une empreinte de fichier ne périme
# pas, et un domaine reste rattaché à qui l'a déposé.
CTI_IP_MAX_JOURS=365

# Types d'attributs MISP retenus. Le reste (registre, mutex, mails) n'a pas de
# champ correspondant dans les alertes de ce parc.
CTI_TYPES_MISP=ip-src,ip-dst,domain,hostname,url,md5,sha1,sha256

# Garde-fou de volume, par source. Un feed qui déraille (URL morte renvoyant une
# page HTML parsée en IOC) doit faire échouer la synchro, pas remplir le cache.
CTI_MAX_IOC=1000000

# Âge à partir duquel le cache est déclaré périmé (règle 100956, niveau 12).
# 24 h = quatre cycles manqués pour les feeds les plus rapides. Une CTI figée ne
# lève aucune erreur : elle répond, de plus en plus faux — même angle mort qu'un
# capteur muet.
CTI_PEREMPTION_HEURES=24

# --- Veille : IOC extraits d'articles publics (soc-agent-cti-articles) ---
# Presse et blogs de sécurité (sources dans cti_feeds.yaml, section `articles`).
# Les IOC y sont en prose : un étage déterministe trouve les candidats, le LLM
# tranche, du code revérifie.
#
# Articles lus par source et par passe (une passe / 30 min). Seul robinet du coût
# LLM du module : ~8 k tokens d'entrée par article, donc 32 appels max par passe
# à 8 articles et 4 sources — en pratique bien moins.
CTI_ARTICLES_MAX=8


# ============================================================================
# THREAT HUNTING (index set de restauration, cf. docs/HUNTING.md)
# ============================================================================
#
# `wazuh-hunting-*` est l'espace où l'on REMET une archive froide pour chasser
# dedans. Ce n'est PAS un index set de routage : aucune source n'y écrit. Il lui
# manque délibérément deux des cinq pièces d'un index set, et cette absence est
# la fonctionnalité :
#
#  - PAS lu par l'ingestion. Ré-ingérer des alertes vieilles de dix mois les
#    ferait corréler, trier, puis REMÉDIER — restaurer mars 2026 déclencherait
#    une isolation d'hôte en réponse à une attaque de l'an dernier. L'exclusion
#    est structurelle (négation `-wazuh-hunting-*` dans routage.indices_lus) ;
#  - PAS observé par le routage, qui verrait sinon une dérive et ouvrirait une
#    alerte IRIS pour rien.
#
# Il garde le template (même mapping que les alertes vivantes), un index pattern
# Discover, et sa propre rétention.
HUNTING_INDEX_BASE=wazuh-hunting

# Rétention par une politique ISM dédiée (`aura-hunting`). Courte exprès : ce
# sont des COPIES d'archives qui vivent douze mois de leur côté, et de l'espace
# de travail qui traîne est le moyen le plus simple de remplir le disque du SOC.
HUNTING_RETENTION_JOURS=30

# Garde-fous de la restauration : cet espace est accessible par le serveur MCP,
# donc par un agent IA — « restaure-moi tout pour voir » doit être refusé par le
# CODE. S'y ajoute un refus net si le disque dépasse DISQUE_SEUIL_ALERTE.
HUNTING_MAX_DOCS=2000000
HUNTING_MAX_INDICES=10
HUNTING_MAX_GO=10

# Taille des lots _bulk de la réinjection. 2 000 documents font ~6 Mo ; au-delà,
# l'indexer met son heap sous pression sans aller plus vite.
HUNTING_BULK_TAILLE=2000


# ============================================================================
# ARCHIVAGE À FROID VERS S3 (soc-agent-archive, cf. docs/ARCHIVAGE.md)
# ============================================================================
#
# La rétention SUPPRIME à 90 jours. L'archivage est la copie qui survit : un
# objet par (index set × mois), NDJSON compressé puis CHIFFRÉ côté client, rangé
# en `v1/<index-set>/<annee>/`.
#
# AVANT de passer à true, dans cet ordre :
#   1. générer la clé sur l'hôte :
#        install -d -m 700 /etc/aura/keys
#        age-keygen -o /etc/aura/keys/aura-archive-age.key
#        chmod 400 /etc/aura/keys/aura-archive-age.key
#   2. la SAUVEGARDER hors ligne (la perdre perd tout) ;
#   3. créer le bucket B2 (privé, région UE) et une clé applicative scopée à ce
#      seul bucket, SANS le droit de suppression ;
#   4. valider : docker compose -p aura run --rm soc-agent-archive \
#                  python -m soc_agent.archive --verifier
ARCHIVAGE_ENABLED=false

# --- Backblaze B2 (endpoint S3-compatible) ---
# La région fait partie du nom d'hôte. eu-central-003 = Amsterdam : évite un
# transfert hors UE à documenter au registre. Ça ne met PAS la donnée hors de
# portée du CLOUD Act (Backblaze est américaine) — c'est le chiffrement client
# qui s'en charge.
ARCHIVE_S3_ENDPOINT=https://s3.eu-central-003.backblazeb2.com
ARCHIVE_S3_REGION=eu-central-003

# Bucket DÉDIÉ et privé : dédié parce que ça permet de scoper la clé applicative
# à ce seul bucket, une clé volée ne découvre pas le reste.
ARCHIVE_S3_BUCKET=aura-archives

# Clé applicative B2. Droits attendus : listFiles + readFiles + writeFiles. PAS
# deleteFiles — un rançongiciel qui prend cet hôte doit être incapable d'effacer
# les douze mois après avoir chiffré le reste. La purge des archives échues
# appartient à la RÈGLE DE CYCLE DE VIE du bucket, pas à ce code.
ARCHIVE_S3_KEY_ID=changeme
ARCHIVE_S3_APP_KEY=changeme

# Préfixe racine facultatif, si le bucket est partagé. Vide avec un bucket dédié.
ARCHIVE_S3_PREFIX=

# --- Chiffrement (age, clé détenue par le SOC) ---
# Le SOC détient la clé COMPLÈTE : le drill de restauration déchiffre tout seul
# (il prouve la LISIBILITÉ, pas seulement l'intégrité) et restaurer un mois ne
# demande aucune manipulation de clé.
#
# Le coût : ce fichier est la seule chose qui sépare un attaquant ayant root sur
# cet hôte de douze mois d'archives. Le modèle de menace couvert est « Backblaze
# lit mes archives », PAS « le SOC est compromis ». D'où 0400, root, hors de tout
# volume partagé.

# Répertoire de l'HÔTE contenant la clé, monté en lecture seule sur /run/secrets.
# Le répertoire et pas le fichier : docker crée un répertoire à la place d'une
# source absente, et monter le fichier casserait le conteneur sans message clair.
ARCHIVE_KEY_DIR_HOST=/etc/aura/keys

# Chemin de la clé VU DEPUIS LE CONTENEUR.
ARCHIVE_AGE_KEYFILE=/run/secrets/aura-archive-age.key

# Clés PUBLIQUES de SECOURS (« age1… »), virgules. Utile pour une seule chose :
# une clé dont la privée dort hors ligne en coffre — chaque archive devient
# déchiffrable par le SOC *ou* par elle, et le SOC peut perdre sa clé sans perdre
# l'historique. Sans clé de secours, la sauvegarde hors ligne du keyfile est la
# SEULE protection : personne ne récupère une archive age dont la clé est perdue.
ARCHIVE_AGE_RECIPIENTS_EXTRA=

# --- Object Lock (WORM) ---
# Ce qui distingue un archivage d'une sauvegarde : permet d'affirmer devant un
# auditeur que l'objet n'a pas pu être modifié. À LIRE AVANT DE PASSER À true :
#  - le bucket doit avoir été CRÉÉ avec Object Lock, la propriété ne se
#    rétro-applique pas ;
#  - en COMPLIANCE, AUCUNE suppression avant l'échéance, y compris par le
#    propriétaire du compte et y compris en cas d'erreur : la facture des douze
#    mois est due quoi qu'il arrive ;
#  - GOVERNANCE laisse une porte de sortie à un compte privilégié — plus
#    confortable, moins probant.
ARCHIVE_OBJECT_LOCK=false
ARCHIVE_OBJECT_LOCK_MODE=COMPLIANCE
ARCHIVE_OBJECT_LOCK_JOURS=365

# --- Périmètre ---
# Motifs candidats. `wazuh-*` DÉLIBÉRÉMENT large : le piège maison est la liste à
# tenir à jour qu'on oublie (trois fois pour INDEXER_ALERT_INDICES, chaque oubli
# était un capteur invisible). Un index set créé demain doit être archivé sans
# qu'on y pense. Ce qui borne réellement, c'est la FORME du nom : seuls les index
# datés au jour (`-AAAA.MM.JJ`) sont archivés — en sont donc exclus sans aucune
# liste `wazuh-voc-vulns` (index d'état) et `wazuh-monitoring-*` /
# `wazuh-statistics-*` (datés à la semaine).
ARCHIVE_INDEX_MOTIFS=wazuh-*

# Exclusions supplémentaires, motifs glob sur le nom d'index complet.
ARCHIVE_INDEX_EXCLUS=

# Champs retirés de `_source` avant écriture. VIDE, et c'est un choix : une
# archive amputée ne se répare pas, et l'économie porterait sur quelques Go/an.
ARCHIVE_CHAMPS_EXCLUS=

# --- Cadence et bornes ---
# Version du FORMAT d'archive (préfixe des clés S3). Ne pas l'incrémenter pour un
# changement de réglage — seulement si le codec, la projection ou le schéma du
# manifeste changent, pour que v2 cohabite avec v1.
ARCHIVE_FORMAT_VERSION=v1

# Grâce après la fin du mois avant de le figer. Pas décoratif : le rattrapage des
# alertes indexées en retard écrit encore dans les index de la veille. Archiver
# trop tôt fige une copie incomplète, qui se croira complète.
ARCHIVE_DELAI_JOURS=2

# Rétention visée des archives, en mois. Référence du manifeste et des contrôles
# de cohérence ; la suppression appartient au cycle de vie du bucket.
ARCHIVE_RETENTION_MOIS=12

# Marge entre archivage et purge ISM, en jours. Un index qui entre dans cette
# marge sans archive confirmée est DÉTACHÉ de la politique ISM jusqu'à ce que sa
# copie existe. Le disque grossira — perdre de la donnée est pire.
ARCHIVE_MARGE_JOURS=7

# Niveau zstd (19 = ~20-30x sur du JSON d'alerte) et taille de page de l'export.
ARCHIVE_ZSTD_NIVEAU=19
ARCHIVE_TAILLE_LOT=5000

# Drill de restauration : N archives relues par passage, et âge au-delà duquel
# une archive non relue est signalée. Une archive non testée est une croyance.
# COMPLET=true déchiffre et recompte les documents contre le manifeste, donc
# prouve la LISIBILITÉ (possible parce que le SOC détient sa clé). false limite
# au SHA-256 de l'objet — utile si la clé est momentanément absente, mieux vaut
# un contrôle partiel qu'un faux échec.
ARCHIVE_DRILL_LOT=3
ARCHIVE_DRILL_JOURS=90
ARCHIVE_DRILL_COMPLET=true

# Répertoire de travail. L'archive y est écrite DÉJÀ CHIFFRÉE — le clair ne
# touche jamais le disque. Prévoir de la place : un export est refusé s'il n'a
# pas de quoi s'écrire, un disque plein arrête tout le SOC.
ARCHIVE_TMP_DIR=/tmp


# ============================================================================
# DFIR-IRIS (case management)
# ============================================================================

# --- Accès (client soc-agent) ---
IRIS_URL=https://127.0.0.1:8443
IRIS_VERIFY_TLS=false
IRIS_CUSTOMER=1

# Clé d'API, consommée par iris-app/iris-worker (bootstrap admin) ET par
# soc-agent (création des cases). 64 caractères hexadécimaux.
#   openssl rand -hex 32
# Préférer à terme un compte de service dédié plutôt que l'admin.
IRIS_API_KEY=__CHANGE_ME__

# --- Version ---
# Release upstream épinglée. Avant de changer : lire le CHANGELOG, les migrations
# de schéma sont irréversibles. Sauvegarder db/iris-postgres d'abord.
IRIS_VERSION=v2.4.27

# --- Base de données ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=__CHANGE_ME__
POSTGRES_ADMIN_USER=raptor
POSTGRES_ADMIN_PASSWORD=__CHANGE_ME__
POSTGRES_DB=iris_db
POSTGRES_SERVER=iris-db
POSTGRES_PORT=5432

# --- Secrets applicatifs ---
# SECRET_KEY signe les sessions ; le salt dérive les hash de mots de passe.
# Changer le salt après création des comptes invalide tous les mots de passe.
IRIS_SECRET_KEY=__CHANGE_ME__
IRIS_SECURITY_PASSWORD_SALT=__CHANGE_ME__

# --- Réseau / TLS ---
# 8443 et pas 443 : le dashboard Wazuh occupe déjà 443 sur cet hôte.
INTERFACE_HTTPS_PORT=8443
# 127.0.0.1 = hôte seulement. 0.0.0.0 expose l'interface au LAN : dans ce cas,
# remplacer le certificat auto-signé.
IRIS_BIND_ADDR=127.0.0.1
SERVER_NAME=iris.soc.local
CERT_FILENAME=iris_cert.pem
KEY_FILENAME=iris_key.pem

# --- Authentification ---
IRIS_AUTHENTICATION_TYPE=local

# Compte administrateur créé au premier démarrage. IRIS_ADM_PASSWORD vide = mot
# de passe aléatoire visible une seule fois dans les logs de iris-app
# (`docker compose logs iris-app | grep -i password`).
#IRIS_ADM_USERNAME=administrator
#IRIS_ADM_EMAIL=admin@soc.local
#IRIS_ADM_PASSWORD=__CHANGE_ME__

# --- Interne ---
DOCKERIZED=1
LOG_LEVEL=info
IRIS_UPSTREAM_SERVER=iris-app
IRIS_UPSTREAM_PORT=8000
IRIS_FRONTEND_SERVER=iris-app
IRIS_FRONTEND_PORT=5173
CELERY_BROKER=amqp://iris-rabbitmq
# Par défaut IRIS lance un process Celery par cœur (16 ici) pour quelques tâches
# par heure. On garde les cœurs pour le reste.
IRIS_WORKER_CONCURRENCY=2


# ============================================================================
# SHUFFLE (orchestration : isolation, kill)
# ============================================================================

# Compte admin créé automatiquement au premier démarrage du backend.
#
# À TRAITER COMME UN SECRET DE PREMIER NIVEAU : shuffle-backend monte
# /var/run/docker.sock, donc qui s'authentifie sur cette API peut faire exécuter
# du code par le démon Docker de l'hôte, c'est-à-dire devenir root SUR LE
# MANAGER. C'est le secret le plus lourd de conséquences du fichier.
#   openssl rand -hex 32
SHUFFLE_DEFAULT_USERNAME=admin
SHUFFLE_DEFAULT_PASSWORD=__CHANGE_ME__
SHUFFLE_DEFAULT_APIKEY=__CHANGE_ME__

# Adresse d'écoute de l'UI (3001) et de l'API (5001). 127.0.0.1 est le bon défaut
# vu ce que l'API donne. Ne passer à 0.0.0.0 qu'avec un pare-feu devant ET les
# deux secrets ci-dessus réellement changés.
SHUFFLE_BIND_ADDR=127.0.0.1

# Webhooks déclenchés par la remédiation (cf. MITIGATE_EXECUTE).
SHUFFLE_URL=http://localhost:5001
SHUFFLE_WEBHOOK_ISOLATE=webhook_00000000-0000-0000-0000-00000000a001
SHUFFLE_WEBHOOK_KILL=webhook_00000000-0000-0000-0000-00000000a002


# ============================================================================
# SERVEUR MCP AURA (cf. docs/MCP.md)
# ============================================================================
#
# Un endpoint unique pour piloter AURA depuis un client IA. Il relaie aussi les
# serveurs MCP Wazuh et IRIS : le client n'en déclare qu'un.

# Secret de signature des jetons (openssl rand -hex 32). SANS LUI LE SERVEUR
# REFUSE DE DÉMARRER — un MCP AURA ouvert donne isolate/kill à qui atteint le
# port. Le changer révoque tous les jetons émis, il n'y a pas d'autre révocation.
AURA_MCP_SECRET=changeme

# Adresse d'écoute. Le conteneur est en network_mode: host, donc le compose ne
# peut PAS restreindre l'exposition avec `ports:` — c'est cette valeur qui le
# fait. Ne mettre 0.0.0.0 qu'avec un pare-feu devant, jamais « pour tester ».
AURA_MCP_HOST=127.0.0.1
AURA_MCP_PORT=3100
AURA_MCP_PATH=/mcp

# Claims attendues dans les jetons. À changer seulement si un autre serveur MCP
# partage le même secret, ce qu'il vaut mieux éviter.
AURA_MCP_ISSUER=aura
AURA_MCP_AUDIENCE=aura-mcp

# Anti-rebinding DNS : origines et hôtes acceptés dans les en-têtes HTTP.
AURA_MCP_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1
AURA_MCP_ALLOWED_HOSTS=localhost,127.0.0.1

# Appels par minute et par sujet de jeton. Vise la boucle d'un agent IA qui
# rappelle le même outil en rafale, pas un usage humain.
AURA_MCP_RATE_LIMIT=120

# Plafonds de réponse : une réponse d'outil part dans la fenêtre de contexte d'un
# LLM. PAGE_MAX borne la pagination, TEXTE_MAX tronque les champs bruts
# (full_log, lignes de commande) en annonçant la troncature.
AURA_MCP_PAGE_DEFAUT=25
AURA_MCP_PAGE_MAX=100
AURA_MCP_TEXTE_MAX=4000

# Clé SSH d'exploitation montée dans le conteneur MCP (chemin côté hôte).
# Utilisée par etat_isolation et par l'enrôlement d'agent. Le fichier DOIT
# exister : docker crée un répertoire à sa place sinon, et le montage casse le
# conteneur au démarrage sans message clair.
SSH_KEY_HOST=/root/.ssh/id_ed25519

# --- Relais vers les serveurs MCP amont ---
# Les 19 outils d'active response du serveur Wazuh sont MASQUÉS par le relais :
# ils agiraient sur le manager sans les garde-fous d'AURA.

# Secret de signature des jetons du serveur MCP Wazuh (openssl rand -hex 32).
WAZUH_MCP_SECRET=changeme
WAZUH_MCP_PORT=3000

# URL et jeton utilisés par le relais pour joindre chaque amont. Vide désactive
# le relais correspondant : AURA démarre quand même et le dit dans son journal —
# le SOC doit rester interrogeable quand une brique tombe.
AURA_MCP_WAZUH_URL=http://127.0.0.1:3000/mcp
AURA_MCP_WAZUH_TOKEN=
AURA_MCP_IRIS_URL=
AURA_MCP_IRIS_TOKEN=


# ============================================================================
# TOPOLOGIE DÉPLOYÉE HORS DÉPÔT (agents / forensique manager)
# ============================================================================
#
# Ces variables ne sont PAS lues par docker compose : ce sont des machines sans
# accès à ce .env (agents potentiellement compromis, hôte manager pour le bloc
# forensique) qui en ont besoin. Éditées ici pour rester dans la source de vérité
# unique, puis extraites par `src/wazuh/generate-soc-ai-conf.sh` dans un fichier
# à part (`src/wazuh/soc-ai.conf`, gitignored) fait pour voyager — jamais ce .env
# complet, qui contient DEEPSEEK_API_KEY, les mots de passe DB et la clé IRIS.

# IP du manager TELLE QUE LES AGENTS LA JOIGNENT (pas l'IP vue du manager
# lui-même, ni 127.0.0.1). Utilisée par host-isolate.sh : seule sortie laissée
# ouverte pendant l'isolation, donc seule façon de garder l'agent pilotable. Une
# valeur fausse ici coupe l'agent définitivement.
WAZUH_MANAGER_IP=

# Marque un hôte d'INFRASTRUCTURE (pare-feu, reverse proxy, DNS, VPN,
# hyperviseur) : à 1, host-isolate.sh REFUSE de l'isoler — couper une machine qui
# achemine le trafic d'autrui provoque une panne au lieu de contenir un incident.
# Déployé par agent, donc une valeur par machine.
SOC_AI_NO_ISOLATE=0

# --- Collecte forensique (hôte manager, /etc/soc-ai/) ---
# Le manager TIRE les preuves de l'agent puis les pousse vers un dépôt séparé.
# Accès manager -> agent, borné côté agent par une forced command
# (forensic-source.sh, ram|disk|meta seulement).
AGENT_SSH_USER=forensic
AGENT_SSH_KEY=/etc/soc-ai/forensic_agent_ed25519
AGENT_KNOWN_HOSTS=/etc/soc-ai/known_hosts_agents

# Accès manager -> serveur de dépôt (écriture des preuves). Hôte SÉPARÉ de la
# machine analysée et du manager.
EVIDENCE_HOST=
EVIDENCE_USER=forensics
EVIDENCE_PATH=/var/lib/forensics
EVIDENCE_SSH_KEY=/etc/soc-ai/forensic_evidence_ed25519
EVIDENCE_KNOWN_HOSTS=/etc/soc-ai/known_hosts_evidence
