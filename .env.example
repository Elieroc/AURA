# Configuration AURA — copier en .env et remplir.
#   cp .env.example .env
# .env est gitignored. Générer chaque secret séparément :
#   openssl rand -hex 32

# ===== WAZUH =====

# Mot de passe API Wazuh indexer (utilisé par manager + dashboard + soc-agent)
INDEXER_PASSWORD=changeme

# Enrichissement threat intel (à reporter aussi dans src/wazuh/config/wazuh_cluster/wazuh_manager.conf)
WAZUH_VT_API_KEY=changeme
WAZUH_ABUSEIPDB_API_KEY=changeme

# Mot de passe API Wazuh (user wazuh-wui) — règle Wazuh : 8+ car., maj/min/chiffre/spécial
# Fusion de l'ancien API_PASSWORD (wazuh) et WAZUH_API_PASSWORD (ai) : même secret,
# consommé par wazuh.manager/dashboard ET par soc-agent.
WAZUH_API_PASSWORD=changeme

# ===== AI / SOC-AGENT =====

# --- Base du soc-agent ------------------------------------------------------
# openssl rand -hex 24
PGPASSWORD=__CHANGE_ME__
PGUSER=socagent
PGDATABASE=socagent
PGPORT=5433

# --- Indexer Wazuh (source des alertes) -------------------------------------
INDEXER_URL=https://127.0.0.1:9200
INDEXER_USER=admin
# Certificats auto-signés sur la loopback. Passer à true (avec INDEXER_CA)
# dès que l'indexer n'est plus joint en local.
INDEXER_VERIFY_TLS=false
#INDEXER_CA=/chemin/vers/root-ca.pem

# --- Filtrage ---------------------------------------------------------------
# Niveau Wazuh minimal envoyé au triage. 12 = seuil "high" (12-14 high, 15
# critical). En dessous, l'alerte est stockée pour les statistiques seulement.
MIN_LEVEL=12
ATTACH_MIN_LEVEL=3
# Niveau minimal à ingérer. 0 = tout stocker, ce qui donne les statistiques
# complètes de l'entonnoir. Monter à MIN_LEVEL une fois la mesure faite.
INGEST_MIN_LEVEL=0

# --- Rattrapage des alertes indexées en retard -------------------------------
# Le curseur d'ingestion avance sur la date de l'ÉVÉNEMENT, pas sur celle de son
# indexation : toute alerte devenue visible après le passage du curseur serait
# sautée définitivement.
# Recul de sécurité à chaque reprise, couvre le skew agent->manager->indexer.
INGEST_LOOKBACK_MINUTES=15
# Balayage complet périodique, indépendant du curseur : récupère les logs qu'un
# agent déconnecté rejoue à la reconnexion avec leur horodatage d'origine.
# 48 h couvre une coupure de week-end.
INGEST_SWEEP_HOURS=48
INGEST_SWEEP_INTERVAL_MINUTES=60

# --- DeepSeek (API cloud, compatible OpenAI) --------------------------------
# Clé depuis platform.deepseek.com > API Keys. Donne accès au crédit payant :
# jamais en clair dans le repo. Les données SOC doivent être anonymisées avant
# tout appel (cf. sanitize.py).
DEEPSEEK_API_KEY=__CHANGE_ME__
DEEPSEEK_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# --- Filtre VirusTotal des exécutables (vt.py) -------------------------------
# Même valeur que WAZUH_VT_API_KEY : clé réutilisée de l'intégration VT Wazuh.
# Sans elle, le filtre est inactif (aucune suppression, pas un défaut sûr par
# excès — juste moins de filtrage).
VT_API_KEY=changeme

# --- Remédiation (exécution des actions) ------------------------------------
# false = DRY-RUN (montre, n'agit pas). true = exécute réellement sur la prod.
MITIGATE_EXECUTE=false
SHUFFLE_URL=http://localhost:5001
SHUFFLE_WEBHOOK_ISOLATE=webhook_00000000-0000-0000-0000-00000000a001
SHUFFLE_WEBHOOK_KILL=webhook_00000000-0000-0000-0000-00000000a002
# API Wazuh (blocage IP, désactivation compte).
WAZUH_API_URL=https://127.0.0.1:55000
WAZUH_API_USER=wazuh-wui
# Agents « capteur d'hôte » : leur télémétrie décrit d'AUTRES machines (ex.
# l'auditd de l'hôte Proxmox voit les execve de ses conteneurs). Une remédiation
# ne les vise JAMAIS (théâtre réel ailleurs) — dans le doute, on n'agit pas.
# En prod : l'agent de l'hôte Proxmox (009). Vide = aucun capteur déclaré.
AGENTS_CAPTEURS=009

# --- Corrélation ------------------------------------------------------------
# Fenêtre pour les liens faibles (tactique MITRE, groupe de règle).
CORRELATION_GAP_MINUTES=30
# Fenêtre pour les liens forts (même IP, même fichier, même compte).
ENTITY_GAP_MINUTES=360
MAX_INCIDENT_HOURS=6
# Fenêtre de fusion CAMPAGNE (approche A) : incidents de plusieurs hôtes réunis
# en un seul case s'ils partagent un marqueur d'attaquant (compte créé, IP C2
# externe, fichier malveillant). 0 = désactive la fusion campagne.
CAMPAGNE_GAP_HOURS=48

# --- Pivot vers le dashboard Wazuh (deep-links des rapports) ----------------
# URL ouverte depuis le NAVIGATEUR de l'analyste, pas depuis cet hôte : ne
# jamais laisser « localhost » (le lien pointerait sur la machine de l'analyste).
WAZUH_DASHBOARD_URL=https://192.168.10.5
# WAZUH_DASHBOARD_DISCOVER_PATH=/app/data-explorer/discover
# WAZUH_DASHBOARD_INDEX_PATTERN=soc-ai-all-alerts

# --- Sous-réseaux internes du parc (qualification des IOC IP) ----------------
# Une IP source ou cible /dev/tcp DANS ces plages = mouvement latéral interne,
# PAS un C2. NE PAS mettre 10.0.0.0/8 en bloc : le C2 du lab y vit. Lister les
# subnets réellement internes.
RESEAUX_INTERNES=192.168.20.0/24,192.168.10.0/24,192.168.40.0/24

# --- Mode training (soc-training) --------------------------------------------
# Fenêtre d'apprentissage du bruit ambiant, à la mise en service du SOC sur un
# SI déjà en production. Pendant la fenêtre, le pipeline d'analyse est SUSPENDU
# (pas de triage LLM, pas de case IRIS, pas de remédiation autonome) : seule
# l'ingestion tourne, et chaque alerte HIGH/CRITICAL observée devient une
# exception de whitelist propre à la machine qui l'a produite. À la clôture, un
# case IRIS « TRAINING » liste chaque exception en tâche ; passer une tâche en
# 'Canceled' désactive l'exception correspondante.
#
# ATTENTION : une intrusion déjà en cours au lancement du SOC serait apprise
# comme du bruit. N'activer que sur un SI qu'on croit sain, et relire le case
# TRAINING à la fin. N'ouvre une fenêtre qu'au TOUT PREMIER démarrage (aucune
# fenêtre en base) : relancer le SOC ne réapprend rien. Pour en rouvrir une :
#   docker exec soc-training python -m soc_agent.training --demarrer --jours 7
TRAINING_ENABLED=false
TRAINING_DAYS=7
# Niveau Wazuh minimum d'une alerte apprise (12 = HIGH, aligné sur MIN_LEVEL).
TRAINING_MIN_LEVEL=12
# Plafond de niveau appris. 15 par défaut : le training doit couvrir le bruit
# CRITICAL, c'est celui qui déclenche les remédiations les plus coûteuses.
TRAINING_MAX_LEVEL=15

# --- DFIR-IRIS (case management) --------------------------------------------
IRIS_URL=https://127.0.0.1:8443
IRIS_VERIFY_TLS=false
IRIS_CUSTOMER=1

# --- Réglage automatique des règles Wazuh (soc-agent-rule-tuning) -----------
# Génère des règles filles d'exception à partir des FP récurrents, pour que le
# bruit soit écarté DANS le moteur de règles (cf. rule_tuning.py). Chaque règle
# est prouvée par rejeu /logtest avant d'être conservée, contre-exemple compris.
# Répertoire de règles du manager, tel que monté sur l'hôte, relatif à la
# racine du dépôt (le compose racine vit désormais à cet endroit).
WAZUH_RULES_DIR=./src/wazuh/config/wazuh_cluster/rules
# Niveau appliqué par l'exception. 5 = on abaisse (l'alerte reste lisible mais
# n'ouvre plus d'incident). 0 = suppression totale, exige le drapeau ci-dessous.
RULE_TUNING_NIVEAU=5
RULE_TUNING_AUTORISE_NIVEAU_0=false
RULE_TUNING_MAX_REGLES=50

# --- Métriques d'IA (soc-agent-metrics -> index wazuh-ai-*) ------------------
# Fenêtre réexportée à chaque passage. L'export est idempotent (_id
# déterministe) : un recouvrement large rattrape une panne d'indexer.
METRICS_FENETRE=6h
# Tarifs du modèle, en USD par million de tokens. Défauts = grille publique de
# deepseek-v4-flash relevée le 2026-07-29. APPROXIMATIF : relevé sur la grille
# publiée, pas sur une facture. Recoupé sur la conso réelle du compte
# (671 593 tokens pour 0,09 USD). Bon ordre de grandeur, pas de la refacturation.
# Le cache hit est 50x moins cher : la ventilation est lue dans la réponse de
# l'API quand elle existe, sinon tout est compté en cache miss (estimation haute).
LLM_COUT_USD_PAR_MTOKEN_IN=0.14
LLM_COUT_USD_PAR_MTOKEN_IN_CACHE=0.0028
LLM_COUT_USD_PAR_MTOKEN_OUT=0.28

# ===== IRIS =====

# --- Version ---------------------------------------------------------------
# Release upstream épinglée. Avant de changer : lire le CHANGELOG, les
# migrations de schéma sont irréversibles. Sauvegarder db/iris-postgres d'abord.
IRIS_VERSION=v2.4.27

# --- Base de données -------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=__CHANGE_ME__
POSTGRES_ADMIN_USER=raptor
POSTGRES_ADMIN_PASSWORD=__CHANGE_ME__
POSTGRES_DB=iris_db
POSTGRES_SERVER=iris-db
POSTGRES_PORT=5432

# --- Secrets applicatifs ---------------------------------------------------
# IRIS_SECRET_KEY signe les sessions ; le salt dérive les hash de mots de
# passe. Changer le salt après création des comptes invalide tous les mots de
# passe existants.
IRIS_SECRET_KEY=__CHANGE_ME__
IRIS_SECURITY_PASSWORD_SALT=__CHANGE_ME__

# --- Réseau / TLS ----------------------------------------------------------
# 8443 et pas 443 : le dashboard Wazuh occupe déjà 443 sur cet hôte.
INTERFACE_HTTPS_PORT=8443
# 127.0.0.1 = accessible seulement depuis l'hôte. Mettre 0.0.0.0 expose
# l'interface au LAN : dans ce cas, remplacer le certificat auto-signé.
IRIS_BIND_ADDR=127.0.0.1

SERVER_NAME=iris.soc.local
CERT_FILENAME=iris_cert.pem
KEY_FILENAME=iris_key.pem

# --- Interne ---------------------------------------------------------------
DOCKERIZED=1
LOG_LEVEL=info
IRIS_UPSTREAM_SERVER=iris-app
IRIS_UPSTREAM_PORT=8000
IRIS_FRONTEND_SERVER=iris-app
IRIS_FRONTEND_PORT=5173
CELERY_BROKER=amqp://iris-rabbitmq

# Nombre de process Celery. Par défaut IRIS en lance un par cœur (16 sur cet
# hôte) pour quelques tâches par heure. On garde les cœurs pour le LLM.
IRIS_WORKER_CONCURRENCY=2

# --- Authentification ------------------------------------------------------
IRIS_AUTHENTICATION_TYPE=local

# Compte administrateur créé au premier démarrage. Si IRIS_ADM_PASSWORD est
# laissé vide, IRIS génère un mot de passe aléatoire visible une seule fois
# dans les logs de iris-app (`docker compose logs iris-app | grep -i password`).
#IRIS_ADM_USERNAME=administrator
#IRIS_ADM_EMAIL=admin@soc.local
#IRIS_ADM_PASSWORD=__CHANGE_ME__

# Clé d'API IRIS : fusion de l'ancien IRIS_ADM_API_KEY (iris) et IRIS_API_KEY
# (ai) — même secret, consommé par iris-app/iris-worker (bootstrap admin) ET
# par soc-agent (création des cases). Format attendu : 64 caractères hexadécimaux.
#   openssl rand -hex 32
# Préférer à terme un compte de service dédié plutôt que l'admin.
IRIS_API_KEY=__CHANGE_ME__

# ===== SHUFFLE =====

# Compte admin créé automatiquement au premier démarrage du backend
SHUFFLE_DEFAULT_USERNAME=admin
SHUFFLE_DEFAULT_PASSWORD=changeme
# Clé API du compte admin (chaîne aléatoire longue, ex: openssl rand -hex 32)
SHUFFLE_DEFAULT_APIKEY=changeme
