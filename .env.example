# Configuration AURA — copier en .env et remplir.
#   cp .env.example .env
# .env est gitignored. Générer chaque secret séparément :
#   openssl rand -hex 32

# ===== WAZUH =====

# Mot de passe du compte `admin` de l'indexer (manager + dashboard + soc-agent).
# Le hachage bcrypt correspondant vit dans
# src/wazuh/config/wazuh_indexer/internal_users.yml : les deux doivent être
# régénérés ENSEMBLE, sinon plus rien ne s'authentifie.
#   openssl rand -hex 32
#   python3 scripts/set-indexer-password.py admin
INDEXER_PASSWORD=__CHANGE_ME__

# Mot de passe du compte de service `kibanaserver`, avec lequel le dashboard
# interroge l'indexer. Il valait « kibanaserver » — le mot de passe de
# démonstration d'OpenSearch, publiquement documenté, sur un port qui était
# publié sur toutes les interfaces. Même procédure que ci-dessus :
#   openssl rand -hex 32
#   python3 scripts/set-indexer-password.py kibanaserver
DASHBOARD_PASSWORD=__CHANGE_ME__

# Enrichissement threat intel (à reporter aussi dans src/wazuh/config/wazuh_cluster/wazuh_manager.conf)
WAZUH_VT_API_KEY=changeme
WAZUH_ABUSEIPDB_API_KEY=changeme

# Mot de passe API Wazuh (user wazuh-wui) — règle Wazuh : 8+ car., maj/min/chiffre/spécial
# Fusion de l'ancien API_PASSWORD (wazuh) et WAZUH_API_PASSWORD (ai) : même secret,
# consommé par wazuh.manager/dashboard ET par soc-agent.
WAZUH_API_PASSWORD=changeme

# ===== AI / SOC-AGENT =====

# --- Base du soc-agent ------------------------------------------------------
# openssl rand -hex 24
PGPASSWORD=__CHANGE_ME__
PGUSER=socagent
PGDATABASE=socagent
PGPORT=5433

# --- Indexer Wazuh (source des alertes) -------------------------------------
INDEXER_URL=https://127.0.0.1:9200
INDEXER_USER=admin
# Certificats auto-signés sur la loopback. Passer à true (avec INDEXER_CA)
# dès que l'indexer n'est plus joint en local.
INDEXER_VERIFY_TLS=false
#INDEXER_CA=/chemin/vers/root-ca.pem

# --- Filtrage ---------------------------------------------------------------
# Niveau Wazuh minimal envoyé au triage. 12 = seuil "high" (12-14 high, 15
# critical). En dessous, l'alerte est stockée pour les statistiques seulement.
MIN_LEVEL=12
ATTACH_MIN_LEVEL=3
# Niveau minimal à ingérer. 0 = tout stocker, ce qui donne les statistiques
# complètes de l'entonnoir. Monter à MIN_LEVEL une fois la mesure faite.
INGEST_MIN_LEVEL=0

# --- Rattrapage des alertes indexées en retard -------------------------------
# Le curseur d'ingestion avance sur la date de l'ÉVÉNEMENT, pas sur celle de son
# indexation : toute alerte devenue visible après le passage du curseur serait
# sautée définitivement.
# Recul de sécurité à chaque reprise, couvre le skew agent->manager->indexer.
INGEST_LOOKBACK_MINUTES=15
# Balayage complet périodique, indépendant du curseur : récupère les logs qu'un
# agent déconnecté rejoue à la reconnexion avec leur horodatage d'origine.
# 48 h couvre une coupure de week-end.
INGEST_SWEEP_HOURS=48
INGEST_SWEEP_INTERVAL_MINUTES=60

# --- DeepSeek (API cloud, compatible OpenAI) --------------------------------
# Clé depuis platform.deepseek.com > API Keys. Donne accès au crédit payant :
# jamais en clair dans le repo. Les données SOC doivent être anonymisées avant
# tout appel (cf. sanitize.py).
DEEPSEEK_API_KEY=__CHANGE_ME__
DEEPSEEK_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# --- Filtre VirusTotal des exécutables (vt.py) -------------------------------
# Même valeur que WAZUH_VT_API_KEY : clé réutilisée de l'intégration VT Wazuh.
# Sans elle, le filtre est inactif (aucune suppression, pas un défaut sûr par
# excès — juste moins de filtrage).
VT_API_KEY=changeme

# --- Remédiation (exécution des actions) ------------------------------------
# false = DRY-RUN (montre, n'agit pas). true = exécute réellement sur la prod.
MITIGATE_EXECUTE=false
SHUFFLE_URL=http://localhost:5001
SHUFFLE_WEBHOOK_ISOLATE=webhook_00000000-0000-0000-0000-00000000a001
SHUFFLE_WEBHOOK_KILL=webhook_00000000-0000-0000-0000-00000000a002
# API Wazuh (blocage IP, désactivation compte).
WAZUH_API_URL=https://127.0.0.1:55000
WAZUH_API_USER=wazuh-wui
# Agents « capteur d'hôte » : leur télémétrie décrit d'AUTRES machines (ex.
# l'auditd d'un hôte Proxmox voit les execve de ses conteneurs). Une remédiation
# ne les vise JAMAIS (théâtre réel ailleurs) — dans le doute, on n'agit pas.
# Liste des id d'agents Wazuh concernés, séparés par des virgules. Vide =
# aucun capteur déclaré.
AGENTS_CAPTEURS=

# Agents Windows (isolation/blocage/kill/désactivation de compte partent sur
# les scripts Windows/AD au lieu des .sh Linux). Id d'agents Wazuh, virgules.
AGENTS_WINDOWS=

# Contrôleurs de domaine : exécuteurs des actions de domaine (désactiver un
# compte AD, retirer d'un groupe). Id d'agents Wazuh, virgules.
AGENTS_DC=

# IP(s) que l'isolation d'un hôte Windows laisse joignables (le manager Wazuh).
MITIGATE_ISOLATE_ALLOW=

# IP de l'infrastructure du SOC qui ne sont NI un IOC NI une cible de blocage.
# Le manager, l'indexer, IRIS et Shuffle sont déjà déduits des URL configurées
# et de MITIGATE_ISOLATE_ALLOW : ne remplir que ce qu'elles ne couvrent pas
# (VIP, seconde interface du manager, collecteur tiers). Virgules.
SOC_INFRA_IPS=

# --- Corrélation ------------------------------------------------------------
# Fenêtre pour les liens faibles (tactique MITRE, groupe de règle).
CORRELATION_GAP_MINUTES=30
# Fenêtre pour les liens forts (même IP, même fichier, même compte).
ENTITY_GAP_MINUTES=360
MAX_INCIDENT_HOURS=6
# Fenêtre de fusion CAMPAGNE (approche A) : incidents de plusieurs hôtes réunis
# en un seul case s'ils partagent un marqueur d'attaquant (compte créé, IP C2
# externe, fichier malveillant). 0 = désactive la fusion campagne.
CAMPAGNE_GAP_HOURS=48

# --- Pivot vers le dashboard Wazuh (deep-links des rapports) ----------------
# URL ouverte depuis le NAVIGATEUR de l'analyste, pas depuis cet hôte : ne
# jamais laisser « localhost » (le lien pointerait sur la machine de l'analyste).
WAZUH_DASHBOARD_URL=https://__IP_OU_NOM_DU_MANAGER__
# WAZUH_DASHBOARD_DISCOVER_PATH=/app/data-explorer/discover
# WAZUH_DASHBOARD_INDEX_PATTERN=soc-ai-all-alerts

# --- Sous-réseaux internes du parc (qualification des IOC IP) ----------------
# Une IP source ou cible /dev/tcp DANS ces plages = mouvement latéral interne,
# PAS un C2. NE PAS mettre 10.0.0.0/8 en bloc si une partie de ce bloc est
# routée vers l'extérieur (VPN, cloud privé...). Lister les subnets
# réellement internes du parc surveillé, ex: RESEAUX_INTERNES=10.20.0.0/16
RESEAUX_INTERNES=

# --- Mode training (soc-training) --------------------------------------------
# Fenêtre d'apprentissage du bruit ambiant, à la mise en service du SOC sur un
# SI déjà en production. Pendant la fenêtre, le pipeline d'analyse est SUSPENDU
# (pas de triage LLM, pas de case IRIS, pas de remédiation autonome) : seule
# l'ingestion tourne, et chaque alerte HIGH/CRITICAL observée devient une
# exception de whitelist propre à la machine qui l'a produite. À la clôture, un
# case IRIS « TRAINING » liste chaque exception en tâche ; passer une tâche en
# 'Canceled' désactive l'exception correspondante.
#
# ATTENTION : une intrusion déjà en cours au lancement du SOC serait apprise
# comme du bruit. N'activer que sur un SI qu'on croit sain, et relire le case
# TRAINING à la fin. N'ouvre une fenêtre qu'au TOUT PREMIER démarrage (aucune
# fenêtre en base) : relancer le SOC ne réapprend rien. Pour en rouvrir une :
#   docker exec soc-training python -m soc_agent.training --demarrer --jours 7
TRAINING_ENABLED=false
TRAINING_DAYS=7
# Niveau Wazuh minimum d'une alerte apprise (12 = HIGH, aligné sur MIN_LEVEL).
TRAINING_MIN_LEVEL=12
# Plafond de niveau appris. 15 par défaut : le training doit couvrir le bruit
# CRITICAL, c'est celui qui déclenche les remédiations les plus coûteuses.
TRAINING_MAX_LEVEL=15

# --- UEBA (analyse comportementale des alertes LOW/MEDIUM) ------------------
#
# Le pipeline n'ouvre un incident qu'à partir du niveau 12. En dessous tout est
# ingéré mais rien ne graine : une intrusion discrète (énumération, binaire
# déposé, connexion depuis un pays jamais vu) reste invisible. UEBA construit une
# baseline du comportement normal par machine et par compte, score la RARETÉ de
# ce qui arrive, et promeut en incident les concentrations les mieux notées.
# Zéro token : le moteur ne juge pas, il classe. Le verdict VP/FP reste au LLM,
# en bout de chaîne, sur l'incident déjà constitué.
#
# Recette : `docker exec soc-agent-cycle python -m soc_agent.ueba --etat`
UEBA_ENABLED=true

# Maturité d'un profil : sous ce seuil, le scope est OBSERVÉ mais jamais scoré.
# Le premier jour, tout y est inédit — scorer enverrait le parc entier au LLM.
UEBA_MATURITE_JOURS=7
UEBA_MATURITE_MIN_OBS=200

# LE garde-fou de coût. Un seuil de score seul ne borne rien (le volume varie
# d'un facteur dix entre une journée calme et une campagne) ; le budget, lui, est
# un nombre qu'on décide. Un signal non promu n'est pas perdu : il est réévalué
# au cycle suivant, et son score aura grossi s'il continue.
UEBA_BUDGET_JOUR=20
UEBA_BUDGET_PAR_CYCLE=2

# Score minimal pour qu'un signal soit promu. À CALIBRER sur des données réelles
# avant de le durcir ou de l'assouplir, sans consommer un seul token :
#   docker exec soc-agent-cycle python -m soc_agent.ueba --simulation
# puis lire les scores obtenus dans la table `ueba_signals`.
UEBA_SCORE_PLANCHER=35

# Remédiation autonome sur un incident d'origine UEBA. FALSE délibérément : le
# reste du pipeline agit sans validation humaine parce qu'il part d'une règle
# Wazuh de niveau >= 12 ; un incident UEBA part d'un score statistique dont la
# justesse n'est pas encore mesurée. Le LLM rend son verdict, le case IRIS est
# créé avec les actions proposées, rien n'est exécuté. À lever quand les
# verdicts UEBA auront été labellisés.
UEBA_MITIGATE=false

# --- DFIR-IRIS (case management) --------------------------------------------
IRIS_URL=https://127.0.0.1:8443
IRIS_VERIFY_TLS=false
IRIS_CUSTOMER=1

# --- Réglage automatique des règles Wazuh (soc-agent-rule-tuning) -----------
# Génère des règles filles d'exception à partir des FP récurrents, pour que le
# bruit soit écarté DANS le moteur de règles (cf. rule_tuning.py). Chaque règle
# est prouvée par rejeu /logtest avant d'être conservée, contre-exemple compris.
# Répertoire de règles du manager, tel que monté sur l'hôte, relatif à la
# racine du dépôt (le compose racine vit désormais à cet endroit).
WAZUH_RULES_DIR=./src/wazuh/config/wazuh_cluster/rules
# Niveau appliqué par l'exception. 5 = on abaisse (l'alerte reste lisible mais
# n'ouvre plus d'incident). 0 = suppression totale, exige le drapeau ci-dessous.
RULE_TUNING_NIVEAU=5
RULE_TUNING_AUTORISE_NIVEAU_0=false
RULE_TUNING_MAX_REGLES=50

# --- Métriques d'IA (soc-agent-metrics -> index wazuh-ai-*) ------------------
# Fenêtre réexportée à chaque passage. L'export est idempotent (_id
# déterministe) : un recouvrement large rattrape une panne d'indexer.
METRICS_FENETRE=6h
# Tarifs du modèle, en USD par million de tokens. Défauts = grille publique de
# deepseek-v4-flash relevée le 2026-07-29. APPROXIMATIF : relevé sur la grille
# publiée, pas sur une facture. Recoupé sur la conso réelle du compte
# (671 593 tokens pour 0,09 USD). Bon ordre de grandeur, pas de la refacturation.
# Le cache hit est 50x moins cher : la ventilation est lue dans la réponse de
# l'API quand elle existe, sinon tout est compté en cache miss (estimation haute).
LLM_COUT_USD_PAR_MTOKEN_IN=0.14
LLM_COUT_USD_PAR_MTOKEN_IN_CACHE=0.0028
LLM_COUT_USD_PAR_MTOKEN_OUT=0.28

# ===== IRIS =====

# --- Version ---------------------------------------------------------------
# Release upstream épinglée. Avant de changer : lire le CHANGELOG, les
# migrations de schéma sont irréversibles. Sauvegarder db/iris-postgres d'abord.
IRIS_VERSION=v2.4.27

# --- Base de données -------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=__CHANGE_ME__
POSTGRES_ADMIN_USER=raptor
POSTGRES_ADMIN_PASSWORD=__CHANGE_ME__
POSTGRES_DB=iris_db
POSTGRES_SERVER=iris-db
POSTGRES_PORT=5432

# --- Secrets applicatifs ---------------------------------------------------
# IRIS_SECRET_KEY signe les sessions ; le salt dérive les hash de mots de
# passe. Changer le salt après création des comptes invalide tous les mots de
# passe existants.
IRIS_SECRET_KEY=__CHANGE_ME__
IRIS_SECURITY_PASSWORD_SALT=__CHANGE_ME__

# --- Réseau / TLS ----------------------------------------------------------
# 8443 et pas 443 : le dashboard Wazuh occupe déjà 443 sur cet hôte.
INTERFACE_HTTPS_PORT=8443
# 127.0.0.1 = accessible seulement depuis l'hôte. Mettre 0.0.0.0 expose
# l'interface au LAN : dans ce cas, remplacer le certificat auto-signé.
IRIS_BIND_ADDR=127.0.0.1

SERVER_NAME=iris.soc.local
CERT_FILENAME=iris_cert.pem
KEY_FILENAME=iris_key.pem

# --- Interne ---------------------------------------------------------------
DOCKERIZED=1
LOG_LEVEL=info
IRIS_UPSTREAM_SERVER=iris-app
IRIS_UPSTREAM_PORT=8000
IRIS_FRONTEND_SERVER=iris-app
IRIS_FRONTEND_PORT=5173
CELERY_BROKER=amqp://iris-rabbitmq

# Nombre de process Celery. Par défaut IRIS en lance un par cœur (16 sur cet
# hôte) pour quelques tâches par heure. On garde les cœurs pour le LLM.
IRIS_WORKER_CONCURRENCY=2

# --- Authentification ------------------------------------------------------
IRIS_AUTHENTICATION_TYPE=local

# Compte administrateur créé au premier démarrage. Si IRIS_ADM_PASSWORD est
# laissé vide, IRIS génère un mot de passe aléatoire visible une seule fois
# dans les logs de iris-app (`docker compose logs iris-app | grep -i password`).
#IRIS_ADM_USERNAME=administrator
#IRIS_ADM_EMAIL=admin@soc.local
#IRIS_ADM_PASSWORD=__CHANGE_ME__

# Clé d'API IRIS : fusion de l'ancien IRIS_ADM_API_KEY (iris) et IRIS_API_KEY
# (ai) — même secret, consommé par iris-app/iris-worker (bootstrap admin) ET
# par soc-agent (création des cases). Format attendu : 64 caractères hexadécimaux.
#   openssl rand -hex 32
# Préférer à terme un compte de service dédié plutôt que l'admin.
IRIS_API_KEY=__CHANGE_ME__

# ===== SHUFFLE =====

# Compte admin créé automatiquement au premier démarrage du backend.
#
# À TRAITER COMME UN SECRET DE PREMIER NIVEAU : shuffle-backend monte
# /var/run/docker.sock, donc qui s'authentifie sur cette API peut faire exécuter
# du code par le démon Docker de l'hôte, c'est-à-dire devenir root SUR LE
# MANAGER. C'est le secret le plus lourd de conséquences du fichier.
#   openssl rand -hex 32
SHUFFLE_DEFAULT_USERNAME=admin
SHUFFLE_DEFAULT_PASSWORD=__CHANGE_ME__
# Clé API du compte admin.
#   openssl rand -hex 32
SHUFFLE_DEFAULT_APIKEY=__CHANGE_ME__

# Adresse d'écoute de l'UI (3001) et de l'API (5001) Shuffle. 127.0.0.1 =
# accessible seulement depuis l'hôte, ce qui est le bon défaut vu ce que
# l'API donne (cf. ci-dessus). Ne passer à 0.0.0.0 qu'avec un pare-feu devant
# ET les deux secrets ci-dessus réellement changés.
SHUFFLE_BIND_ADDR=127.0.0.1

# ===== TOPOLOGIE DÉPLOYÉE HORS DÉPÔT (agents / forensique manager) =====
#
# Ces variables ne sont PAS lues par docker compose : ce sont des machines
# sans accès à ce .env (agents potentiellement compromis, hôte manager pour
# le bloc forensique, séparé de docker compose) qui en ont besoin. Éditées
# ici pour rester dans la source de vérité unique, puis extraites par
# `src/wazuh/generate-soc-ai-conf.sh` dans un petit fichier à part
# (`src/wazuh/soc-ai.conf`, gitignored) fait pour voyager — jamais ce .env
# complet, qui contient DEEPSEEK_API_KEY/mots de passe DB/clé IRIS.

# IP du manager TELLE QUE LES AGENTS LA JOIGNENT (pas l'IP vue du manager
# lui-même, ni 127.0.0.1). Utilisée par host-isolate.sh : c'est la seule sortie
# laissée ouverte pendant l'isolation, donc la seule façon de garder l'agent
# pilotable. Une valeur fausse ici coupe l'agent définitivement.
WAZUH_MANAGER_IP=

# Marque un hôte d'INFRASTRUCTURE (pare-feu, reverse proxy, DNS, VPN,
# hyperviseur) : à 1, host-isolate.sh REFUSE de l'isoler (couper une machine
# qui achemine le trafic d'autrui provoque une panne au lieu de contenir un
# incident). Déployé par agent, donc une valeur par machine.
SOC_AI_NO_ISOLATE=0

# --- Collecte forensique (hôte manager, /etc/soc-ai/) -----------------------
# Le manager TIRE les preuves de l'agent puis les pousse vers un dépôt séparé.
# Accès manager -> agent, borné côté agent par une forced command
# (forensic-source.sh, ram|disk|meta seulement).
AGENT_SSH_USER=forensic
AGENT_SSH_KEY=/etc/soc-ai/forensic_agent_ed25519
AGENT_KNOWN_HOSTS=/etc/soc-ai/known_hosts_agents

# Accès manager -> serveur de dépôt (écriture des preuves). Hôte SÉPARÉ de la
# machine analysée et du manager.
EVIDENCE_HOST=
EVIDENCE_USER=forensics
EVIDENCE_PATH=/var/lib/forensics
EVIDENCE_SSH_KEY=/etc/soc-ai/forensic_evidence_ed25519
EVIDENCE_KNOWN_HOSTS=/etc/soc-ai/known_hosts_evidence

# ===== SERVEUR MCP AURA =====
#
# Un endpoint unique pour piloter AURA depuis un client IA (voir docs/MCP.md).
# Il relaie aussi les serveurs MCP Wazuh et IRIS : le client n'en déclare qu'un.

# Secret de signature des jetons (openssl rand -hex 32). SANS LUI LE SERVEUR
# REFUSE DE DÉMARRER — un MCP AURA ouvert donne isolate/kill à qui atteint le
# port. Le changer révoque tous les jetons émis, il n'y a pas d'autre révocation.
AURA_MCP_SECRET=changeme

# Adresse d'écoute. Le conteneur est en network_mode: host, donc le compose ne
# peut PAS restreindre l'exposition avec `ports:` — c'est cette valeur qui le
# fait. Ne mettre 0.0.0.0 qu'avec un pare-feu devant, jamais « pour tester ».
AURA_MCP_HOST=127.0.0.1
AURA_MCP_PORT=3100
AURA_MCP_PATH=/mcp

# Claims attendues dans les jetons. À changer seulement si un autre serveur MCP
# partage le même secret, ce qu'il vaut mieux éviter.
AURA_MCP_ISSUER=aura
AURA_MCP_AUDIENCE=aura-mcp

# Anti-rebinding DNS : origines et hôtes acceptés dans les en-têtes HTTP.
AURA_MCP_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1
AURA_MCP_ALLOWED_HOSTS=localhost,127.0.0.1

# Appels par minute et par sujet de jeton. Vise la boucle d'un agent IA qui
# rappelle le même outil en rafale, pas un usage humain.
AURA_MCP_RATE_LIMIT=120

# Plafonds de réponse : une réponse d'outil part dans la fenêtre de contexte
# d'un LLM. PAGE_MAX borne la pagination, TEXTE_MAX tronque les champs bruts
# (full_log, lignes de commande) en annonçant la troncature.
AURA_MCP_PAGE_DEFAUT=25
AURA_MCP_PAGE_MAX=100
AURA_MCP_TEXTE_MAX=4000

# Clé SSH d'exploitation montée dans le conteneur MCP (chemin côté hôte).
# Utilisée par etat_isolation et par l'enrôlement d'agent. Le fichier DOIT
# exister : docker crée un répertoire à sa place sinon, et le montage casse le
# conteneur au démarrage sans message clair.
SSH_KEY_HOST=/root/.ssh/id_ed25519

# --- Relais vers les serveurs MCP amont ---
#
# Le serveur AURA relaie Wazuh et IRIS : un client IA ne declare qu'un seul
# serveur MCP. Les 19 outils d'active response du serveur Wazuh sont MASQUES
# par le relais — ils agiraient sur le manager sans les garde-fous d'AURA.

# Secret de signature des jetons du serveur MCP Wazuh (openssl rand -hex 32).
WAZUH_MCP_SECRET=changeme
WAZUH_MCP_PORT=3000

# URL et jeton que le relais AURA utilise pour joindre chaque amont. Laisser
# vide desactive le relais correspondant : AURA demarre quand meme et le dit
# dans son journal — le SOC doit rester interrogeable quand une brique tombe.
AURA_MCP_WAZUH_URL=http://127.0.0.1:3000/mcp
AURA_MCP_WAZUH_TOKEN=
AURA_MCP_IRIS_URL=
AURA_MCP_IRIS_TOKEN=
