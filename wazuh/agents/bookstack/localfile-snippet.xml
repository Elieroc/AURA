  <!-- Aura-SOC : logs Nginx BookStack -> index wazuh-web-* (format combined log
       standard, decodeur natif Wazuh web-accesslog — pas de decoder custom,
       contrairement à npm-proxy/pfsense). -->
  <localfile>
    <log_format>syslog</log_format>
    <location>/root/bookstack/config/log/nginx/access.log</location>
  </localfile>
  <localfile>
    <log_format>syslog</log_format>
    <location>/root/bookstack/config/log/nginx/error.log</location>
  </localfile>
