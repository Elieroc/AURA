  <!-- Aura-SOC : logs Nginx Proxy Manager -> index wazuh-proxy-* (routage dans
       alerts-pipeline.json sur rule.groups contient "npm-proxy").
       Wildcard : NPM nomme ses logs par host proxy (proxy-host-<id>_*.log),
       la liste change à chaque host ajouté/supprimé dans NPM.
       Adapter le chemin si NPM n'est pas installé dans ~root. -->
  <localfile>
    <log_format>syslog</log_format>
    <location>/root/nginx-proxy-manager/data/logs/*_access.log</location>
  </localfile>
  <localfile>
    <log_format>syslog</log_format>
    <location>/root/nginx-proxy-manager/data/logs/*_error.log</location>
  </localfile>
