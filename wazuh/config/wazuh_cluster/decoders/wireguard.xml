<!--
  WireGuard (module noyau) n'a pas d'audit natif : pas de log par pair, `wg
  show` donne seulement un état instantané. Pas de dynamic_debug noyau
  disponible non plus sur wireguard.lab (LXC Proxmox, /sys/kernel/debug
  inaccessible même en root — même contrainte que le manager SOC-AI).

  wg-monitor.py (wazuh/agents/wireguard/) tourne en systemd timer (30s),
  diffuse `wg show wg0 dump` et loggue les TRANSITIONS actif/inactif par pair
  dans /var/log/wireguard-events.log — décodé ici.
-->
<decoder name="wg-monitor">
  <prematch>wg-monitor: event=</prematch>
  <regex offset="after_prematch">^(\S+) peer_ip=(\S+) pubkey=(\S+) endpoint=(\S+)</regex>
  <order>event,peer_ip,pubkey,endpoint</order>
</decoder>
