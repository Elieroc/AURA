<!-- Règles locales SOC-AI -->

<group name="abuseipdb,threat_intel,">

  <!-- Enrichissement AbuseIPDB reçu (toute réponse) -->
  <rule id="100621" level="3">
    <decoded_as>json</decoded_as>
    <field name="integration">custom-abuseipdb</field>
    <description>AbuseIPDB - IP $(abuseipdb.srcip) : score de confiance d'abus $(abuseipdb.abuse_confidence_score)/100 ($(abuseipdb.total_reports) signalements)</description>
    <options>no_full_log</options>
  </rule>

  <!-- IP malveillante : score >= 80 -->
  <rule id="100622" level="12">
    <if_sid>100621</if_sid>
    <field name="abuseipdb.abuse_confidence_score" type="pcre2">^(100|[89][0-9])$</field>
    <description>AbuseIPDB - IP malveillante détectée : $(abuseipdb.srcip) (score $(abuseipdb.abuse_confidence_score)/100, ISP $(abuseipdb.isp), pays $(abuseipdb.country_code))</description>
  </rule>

  <!-- IP suspecte : score 20-79 -->
  <rule id="100623" level="7">
    <if_sid>100621</if_sid>
    <field name="abuseipdb.abuse_confidence_score" type="pcre2">^[2-7][0-9]$</field>
    <description>AbuseIPDB - IP suspecte : $(abuseipdb.srcip) (score $(abuseipdb.abuse_confidence_score)/100)</description>
  </rule>

  <!-- Erreur d'interrogation API -->
  <rule id="100624" level="5">
    <decoded_as>json</decoded_as>
    <field name="integration">custom-abuseipdb</field>
    <field name="abuseipdb.error" type="pcre2">.+</field>
    <description>AbuseIPDB - erreur d'interrogation API pour $(abuseipdb.srcip)</description>
  </rule>

</group>

<group name="threat_hunting,linux,">

  <!-- Exécution d'un binaire depuis un répertoire temporaire world-writable (/tmp, /var/tmp, /dev/shm) -->
  <!-- Nécessite l'audit Linux (auditd) configuré sur l'agent pour surveiller execve. -->
  <rule id="100625" level="8">
    <if_group>audit</if_group>
    <field name="audit.exe" type="pcre2">^(/tmp/|/var/tmp/|/dev/shm/)</field>
    <description>Exécution d'un binaire depuis un répertoire temporaire ($(audit.exe)) - technique classique de drop-and-execute</description>
    <mitre>
      <id>T1204.002</id>
    </mitre>
  </rule>

  <!-- Exclusion /tmp/ansible-tmp-* : garde-fou pour le module ansible.builtin.script
       (pousse et exécute un binaire brut) - suppression via règle enfant niveau 0.
       Deux pièges de decoder Wazuh découverts en testant :
       1. Le pattern PCRE2 lookahead négatif n'est pas honoré par le moteur de règles
          (testé : matchait quand même, contournement via règle enfant niveau 0).
       2. Le décodeur auditd intégré de Wazuh tronque audit.exe au premier tiret
          rencontré (ex. "/tmp/ansible-tmp-123/x" -> "/tmp/ansible", "/tmp/mal-ware"
          -> "/tmp/mal") - d'où le match sur la forme tronquée ci-dessous, pas sur le
          chemin complet. L'exécution normale des modules Ansible (Python) ne
          déclenche de toute façon jamais 100625 : audit.exe résout vers
          l'interpréteur (/usr/bin/python3.x), jamais vers le chemin /tmp (vérifié). -->
  <rule id="100629" level="0">
    <if_sid>100625</if_sid>
    <field name="audit.exe" type="pcre2">^/tmp/ansible$</field>
    <description>Exclusion 100625 : exécution via module ansible.builtin.script (bruit connu)</description>
  </rule>

  <!-- Fork bomb : épuisement de la table de process (ulimit -u / nproc). Détection via
       le message d'erreur émis par le noyau/PAM/le shell quand la limite est atteinte -
       plus fiable et bien moins bruyant qu'auditer clone()/fork() en direct (des millions
       d'événements légitimes par jour). -->
  <rule id="100626" level="12">
    <match type="pcre2">(?i)(fork:\s*(retry:\s*)?resource temporarily unavailable|too many processes|clone\(\) failed)</match>
    <description>Épuisement de la table de process (message noyau/PAM/shell) - signature de fork bomb</description>
    <mitre>
      <id>T1499.001</id>
    </mitre>
  </rule>

  <!-- Exécution fileless via memfd_create : le binaire n'existe qu'en RAM (fichier
       anonyme), jamais écrit sur disque, puis exécuté via /proc/self/fd/N. /proc/PID/exe
       pointe alors vers "/memfd:<nom> (deleted)". Aucun logiciel légitime (hors runc,
       cf. 100632) n'exécute depuis memfd -> IOC fileless très fiable, faible FP.

       IMPORTANT (validé par test end-to-end sur l'agent + wazuh-logtest manager) :
       le champ exe d'auditd est HEX-encodé dès qu'il contient un espace - et
       "/memfd:... (deleted)" en contient toujours un. Le décodeur auditd intégré de
       Wazuh NE peuple PAS audit.exe dans ce cas (champ absent). On matche donc la
       signature HEX brute dans le full_log via <regex> :
         2F6D656D66643A = "/memfd:"
       Déjà capté par l'audit execve en place (règle 100625), pas de conf auditd
       supplémentaire (un exec de memfd EST un execve). -->
  <rule id="100630" level="12">
    <if_group>audit</if_group>
    <regex type="pcre2">exe=\w*2F6D656D66643A</regex>
    <description>Exécution fileless détectée : binaire exécuté depuis un fichier anonyme en mémoire (memfd)</description>
    <mitre>
      <id>T1620</id>
    </mitre>
  </rule>

  <!-- Exclusion 100630 : runc/crun/containerd se recopient dans un memfd avant chaque
       exec de conteneur (mitigation CVE-2019-5736, /proc/self/exe cloné) -> 100630
       déclencherait à chaque démarrage de conteneur. "runc_cloned" est fixé par runc.
       Signature HEX : 2F6D656D66643A72756E635F636C6F6E6564 = "/memfd:runc_cloned".
       Testé : une ligne exe=...runc_cloned... tombe bien en niveau 0. -->
  <rule id="100632" level="0">
    <if_sid>100630</if_sid>
    <regex type="pcre2">exe=\w*2F6D656D66643A72756E635F636C6F6E6564</regex>
    <description>Exclusion 100630 : re-exec runc/crun via memfd (bruit conteneur connu)</description>
  </rule>

  <!-- Exécution d'un binaire unlinké/supprimé : le fichier est ouvert puis unlink()
       avant execve (fexecve sur fd d'un fichier effacé, DDexec, drop-run-delete).
       /proc/PID/exe -> "<chemin> (deleted)", donc exe HEX-encodé (espace) et absent
       de audit.exe comme pour memfd. On matche le suffixe HEX " (deleted)" :
         202864656C6574656429 = " (deleted)"
       FP plus élevé que memfd (installeurs auto-extractibles, `go run`, snap/flatpak
       peuvent exécuter un binaire temporaire effacé) -> niveau 10, à affiner selon les
       alertes réelles. La règle enfant 100633 évite le doublon avec memfd. -->
  <rule id="100631" level="10">
    <if_group>audit</if_group>
    <regex type="pcre2">exe=\w*202864656C6574656429</regex>
    <description>Exécution fileless détectée : binaire supprimé/unlinké exécuté en mémoire (exec of deleted)</description>
    <mitre>
      <id>T1620</id>
    </mitre>
  </rule>

  <!-- Exclusion 100631 : un memfd correspond aussi au suffixe "(deleted)" ; il est
       déjà couvert plus précisément par 100630 -> on neutralise le doublon. Testé. -->
  <rule id="100633" level="0">
    <if_sid>100631</if_sid>
    <regex type="pcre2">exe=\w*2F6D656D66643A</regex>
    <description>Exclusion 100631 : cas memfd déjà couvert par 100630</description>
  </rule>

  <!-- Exécution fileless depuis un tmpfs monté en mémoire (/dev/shm, /run/shm).
       /dev/shm est un tmpfs (RAM) : y déposer puis exécuter un implant est une
       technique fileless (T1620), plus forte que le simple drop-and-execute en
       /tmp (100625, niveau 8). Deux cas, car auditd renseigne audit.exe avec le
       BINAIRE réellement chargé par le noyau :
       - ELF natif : exe = /dev/shm/... -> 100625 fire (niv.8) ; 100635 le rehausse.
       - SCRIPT (#!/bin/sh) : exe = l'INTERPRETEUR (/bin/dash, python...), le
         chemin du script est dans l'argv -> 100625 ne fire PAS. 100634 le capte
         via exe=interpréteur + chemin tmpfs dans l'argv, en clair ou hex
         (2F6465762F73686D2F = "/dev/shm/", 2F72756E2F73686D2F = "/run/shm/"). -->
  <rule id="100634" level="12">
    <if_group>audit</if_group>
    <field name="audit.exe" type="pcre2">/(?:sh|bash|dash|zsh|ksh|ash|busybox|python[0-9.]*|perl|php|ruby|node|lua|tclsh)$</field>
    <regex type="pcre2">(?i)/(?:dev|run)/shm/|2F(?:646576|72756E)2F73686D2F</regex>
    <description>Exécution fileless : interpréteur lançant un script depuis un tmpfs mémoire (/dev/shm) - $(audit.command)</description>
    <mitre>
      <id>T1620</id>
      <id>T1059</id>
    </mitre>
  </rule>

  <rule id="100635" level="12">
    <if_sid>100625</if_sid>
    <field name="audit.exe" type="pcre2">^/(?:dev|run)/shm/</field>
    <description>Exécution fileless : binaire ELF exécuté depuis un tmpfs mémoire ($(audit.exe))</description>
    <mitre>
      <id>T1620</id>
    </mitre>
  </rule>


</group>

<!-- ===================================================================
     Pack "gaps MITRE" - techniques Linux non couvertes par le ruleset
     Wazuh par defaut. 100% base sur l'audit execve en place (cle
     audit-wazuh-c, cf. 100625). Chaque regle validee end-to-end via
     wazuh-logtest sur le manager (events auditd reels + agreges).

     Rappel decodeur (cf. [[wazuh-auditd-exe-hex-encoding]] / regle 100629) :
     - audit.exe / audit.command / audit.execve.a0..a7 disponibles (argv
       plafonne a a7). Pour un match de sous-chaine dans l'argv, on utilise
       <regex> sur le full_log (robuste au plafond a7 et a l'agregation
       multiline), et <field name="audit.exe"> pour cibler le binaire.
     =================================================================== -->
<group name="threat_hunting,linux,mitre_gaps,">

  <!-- R1 T1059.004 - reverse shell / redirection reseau via /dev/tcp|/dev/udp (bash).
       IMPORTANT (validé live) : le payload d'un `bash -c '...'` contient un espace donc
       auditd HEX-encode l'argument entier -> /dev/tcp n'apparait PAS en clair. On matche
       donc aussi la signature hex : 2F6465762F746370 = "/dev/tcp", ...756470 = "/dev/udp".
       (Le cas clair reste utile si /dev/tcp/... est un argument isole sans espace.) -->
  <rule id="100650" level="12">
    <if_group>audit</if_group>
    <regex type="pcre2">(?i)/dev/(tcp|udp)/|2F6465762F(746370|756470)</regex>
    <description>Reverse shell probable : redirection reseau via /dev/tcp|/dev/udp</description>
    <mitre><id>T1059.004</id></mitre>
  </rule>

  <!-- R2 T1059.004 - netcat/ncat avec exec (-e / -c). -->
  <rule id="100651" level="12">
    <if_group>audit</if_group>
    <field name="audit.exe" type="pcre2">/(nc|ncat|netcat)(\.\w+)?$</field>
    <regex type="pcre2">a\d+=\"-(e|c)\"</regex>
    <description>Reverse shell probable : netcat avec option d'execution (-e/-c)</description>
    <mitre><id>T1059.004</id></mitre>
  </rule>

  <!-- R3 T1059 - interpreteur avec code inline de reverse shell (socket/pty/dup2).
       FP possible : developpeurs executant du code socket legitime -> niveau 10. -->
  <!-- Le code inline (python -c '...', perl -e '...') contient des espaces -> arg
       hex-encode par auditd. On matche donc les idiomes de reverse shell en clair ET
       en hex : 7074792E737061776E="pty.spawn", 66736F636B6F70656E="fsockopen",
       736F636B65742E736F636B6574="socket.socket". -->
  <rule id="100652" level="10">
    <if_group>audit</if_group>
    <regex type="pcre2">(?i)pty\.spawn|socket\.socket|os\.dup2|fsockopen|IO::Socket::INET|/inet/tcp/|Socket\.new|7074792E737061776E|66736F636B6F70656E|736F636B65742E736F636B6574</regex>
    <description>Reverse shell probable : interpreteur avec primitives socket/pty inline</description>
    <mitre><id>T1059</id></mitre>
  </rule>

  <!-- R4 T1003.008 - lecture de /etc/shadow|/etc/gshadow via utilitaire fichier. -->
  <rule id="100653" level="12">
    <if_group>audit</if_group>
    <field name="audit.exe" type="pcre2">/(cat|less|more|head|tail|cp|dd|xxd|od|base64|strings|sort|awk|sed|nano|vi|vim|cut|grep)$</field>
    <regex type="pcre2">/etc/(shadow|gshadow)</regex>
    <description>Acces credentials : lecture de /etc/shadow via $(audit.command)</description>
    <mitre><id>T1003.008</id></mitre>
  </rule>

  <!-- R5 T1562.001 - arret/desactivation d'un service de securite/journalisation,
       purge des regles auditd (auditctl -D), desactivation SELinux (setenforce 0).
       FP possible : maintenance admin legitime -> a corroborer avec le contexte. -->
  <rule id="100654" level="12">
    <if_group>audit</if_group>
    <field name="audit.exe" type="pcre2">/(systemctl|service|rc-service|auditctl|setenforce)$</field>
    <regex type="pcre2">(?i)(stop|disable|mask)\b.{0,60}(auditd|wazuh|rsyslog|syslog|firewalld|ufw|falco|osquery|clamav|apparmor|fail2ban)|a\d+="(-D|0)"</regex>
    <description>Defense evasion : alteration d'un service de securite/journalisation</description>
    <mitre><id>T1562.001</id></mitre>
  </rule>

  <!-- R6 T1070.002 - destruction de logs (rm/shred/truncate sur /var/log). -->
  <rule id="100655" level="10">
    <if_group>audit</if_group>
    <field name="audit.exe" type="pcre2">/(rm|shred|truncate|unlink)$</field>
    <regex type="pcre2">/var/log/(auth|syslog|secure|audit|wazuh|messages|journal)</regex>
    <description>Defense evasion : suppression/troncature de journaux ($(audit.command))</description>
    <mitre><id>T1070.002</id></mitre>
  </rule>

  <!-- R7 T1548.001 - creation d'un binaire SUID/SGID via chmod (octal 4xxx/2xxx/6xxx
       ou symbolique u+s/g+s). FP possible : installeurs -> niveau 10. -->
  <rule id="100656" level="10">
    <if_group>audit</if_group>
    <field name="audit.exe" type="pcre2">/chmod$</field>
    <regex type="pcre2">a\d+=\"(0?[2467][0-7]{3}|[ugoa]*\+s\w*)\"</regex>
    <description>Privilege escalation : creation d'un binaire SUID/SGID (chmod $(audit.execve.a1))</description>
    <mitre><id>T1548.001</id></mitre>
  </rule>

  <!-- R8 T1082/T1033/T1057 - reconnaissance systeme (base niv.2 + rafale niv.10). -->
  <rule id="100657" level="2">
    <if_group>audit</if_group>
    <field name="audit.command" type="pcre2">^(whoami|id|uname|hostname|hostnamectl|uptime|lscpu|lsb_release|w|who|last|groups|arch|nproc|dnsdomainname|domainname)$</field>
    <description>Commande de reconnaissance systeme ($(audit.command))</description>
    <mitre><id>T1082</id></mitre>
  </rule>
  <!-- Correlation par frequence. NB (teste) : <same_field>audit.auid</same_field>
       empeche la correlation dans cette version de Wazuh (la regle ne se declenche
       jamais) -> retire. Correlation donc a l'echelle de l'hote (tous utilisateurs).
       Seuil volontairement haut (12 cmd / 30s) : la collecte de facts Ansible et les
       agents de monitoring lancent des rafales de discovery -> affiner si FP. -->
  <rule id="100658" level="10" frequency="12" timeframe="30">
    <if_matched_sid>100657</if_matched_sid>
    <description>Rafale de reconnaissance systeme (12+ commandes en 30s) - enumeration active</description>
    <mitre><id>T1082</id></mitre>
  </rule>

  <!-- ===== Detection d'exploits par nom du fichier execute =====
       Match sur le full_log via <regex> (l'exe complet et l'argv y sont intacts) :
       ne PAS matcher audit.exe qui est tronque a la 1ere ponctuation par le decodeur
       (/home/u/a.out -> /home/u/a), cf. [[wazuh-auditd-exe-hex-encoding]] / 100664. -->

  <!-- R9 T1068 - identifiant CVE dans le binaire execute ou ses arguments
       (ex: ./CVE-2021-4034, python3 CVE-2025-3444.py, cve_2021_4034). Quasi zero FP. -->
  <rule id="100660" level="12">
    <if_group>audit</if_group>
    <regex type="pcre2">(?i)cve[-_]?\d{4}[-_]\d{4,7}</regex>
    <description>Exploitation probable : identifiant CVE dans le fichier/commande execute</description>
    <mitre><id>T1068</id></mitre>
  </rule>

  <!-- R10 T1068 - noms d'exploits publics connus (kernel/LPE). FP negligeable. -->
  <rule id="100661" level="12">
    <if_group>audit</if_group>
    <regex type="pcre2">(?i)(pwnkit|dirtyc0w|dirty[_-]?cow|dirty[_-]?pipe|mempodipper|baron[_-]?samedit|(full|half)[_-]?nelson|dirty[_-]?sock|looney[_-]?tunables|nginxday|glibc[_-]?lpe|ptrace[_-]?traceme|overlayfs[_-]?lpe)</regex>
    <description>Exploitation probable : nom d'exploit public connu execute</description>
    <mitre><id>T1068</id></mitre>
  </rule>

  <!-- R11 T1068 - basename generique d'exploit/PoC execute (./exploit, poc.py,
       privesc, rootkit, getroot...). Ancre sur separateur de chemin/quote pour
       limiter les FP (ex: "epoch" ne matche pas "poc"). Niveau 10. -->
  <rule id="100662" level="10">
    <if_group>audit</if_group>
    <regex type="pcre2">(?i)[/"._-](exploit|expl0it|poc|privesc|rootkit|rootshell|get[_-]?root|getr00t|r00t(ed|sh)?|0day|backdoor|reverse[_-]?shell|revshell)([/"._-]|$)</regex>
    <description>Exploitation probable : basename d'exploit/PoC execute ($(audit.command))</description>
    <mitre><id>T1068</id></mitre>
  </rule>

  <!-- R12 T1595/T1082 - outils publics d'enumeration/priv-esc (recon post-acces). -->
  <rule id="100663" level="8">
    <if_group>audit</if_group>
    <regex type="pcre2">(?i)[/"._-](linpeas|linenum|lse\.sh|les\.sh|linux[_-]?exploit[_-]?suggester|unix[_-]?privesc[_-]?check|pspy\d*|traitor|deepce|kernelpop|gtfo)([/"._-]|$)</regex>
    <description>Post-exploitation probable : outil public d'enumeration/priv-esc execute ($(audit.command))</description>
    <mitre><id>T1082</id></mitre>
  </rule>

  <!-- R13 T1068 - execution d'un a.out (sortie gcc par defaut) : compile-and-run d'un
       PoC/exploit. On matche audit.command (comm decode entier) et non audit.exe
       (tronque a la 1ere ponctuation -> /home/u/a). FP possible (dev) -> niveau 8. -->
  <rule id="100664" level="8">
    <if_group>audit</if_group>
    <field name="audit.command" type="pcre2">^a\.out$</field>
    <description>Exploitation possible : execution d'un binaire a.out (compile-and-run)</description>
    <mitre><id>T1068</id></mitre>
  </rule>

</group>

<!-- ===================================================================
     Detection ransomware (T1486 / T1490 / T1489)
     Strategie : deception (fichiers canaris) plutot que detection de masse.
     Un burst FIM sur /home genere des FP garantis (rsync, apt, git, CI) ;
     un canari n'est touche par AUCUN process legitime -> 1 evenement = 1 alerte.
     Le FIM ne pose des watches que sur les fichiers matchant `restrict`
     (voir agent.conf), donc cout inotify negligeable et volume d'events ~0.
     =================================================================== -->
<group name="ransomware,threat_hunting,linux,">

  <!-- R1 T1486 - canari modifie/chiffre/renomme. Level 15 : aucune raison
       legitime qu'un fichier canari change. `if_group syscheck` couvre les
       regles 550 (modified), 553 (deleted), 554 (added). -->
  <rule id="100670" level="15">
    <if_group>syscheck</if_group>
    <field name="file" type="pcre2">CANARY_SOC_NE_PAS_TOUCHER</field>
    <description>Ransomware probable : fichier canari altere ($(file)) - chiffrement en cours</description>
    <mitre>
      <id>T1486</id>
    </mitre>
  </rule>

  <!-- R2 T1486 - note de rancon deposee. Motifs volontairement specifiques :
       `README` seul est bien trop courant en /home et /srv -> exclu.
       Couvre STOP/Djvu (_readme.txt), LockBit, Conti, Hive, Royal, Akira. -->
  <rule id="100671" level="14">
    <if_group>syscheck</if_group>
    <field name="file" type="pcre2">(?i)(_readme\.txt|how[_ -]?to[_ -]?(decrypt|restore|recover)|(decrypt|restore|recover)[_ -]?(your[_ -]?)?files|readme[_-]for[_-]decrypt|!+[_ -]?restore|ransom[_ -]?note|akira_readme|recover[_-]?your[_-]?data)</field>
    <description>Ransomware probable : note de rancon deposee ($(file))</description>
    <mitre>
      <id>T1486</id>
    </mitre>
  </rule>

  <!-- R3 T1486 - extension de chiffrement connue apposee sur un fichier.
       Scope restreint aux extensions sans usage legitime (pas de .enc/.aes :
       utilises par des outils d'admin). -->
  <rule id="100672" level="14">
    <if_group>syscheck</if_group>
    <field name="file" type="pcre2">(?i)\.(locky|lockbit|conti|ryuk|revil|sodinokibi|djvu|wncry|wannacry|crysis|phobos|makop|mallox|blackcat|royal|akira|basta|8base|cuba|hive|nokoyawa|encrypted|crypted|cryptolocker|kraken|onion|payransom)$</field>
    <description>Ransomware probable : fichier avec extension de chiffrement connue ($(file))</description>
    <mitre>
      <id>T1486</id>
    </mitre>
  </rule>

  <!-- R4 T1490 - destruction des sauvegardes/snapshots avant chiffrement.
       ATTENTION au format auditd : les arguments arrivent decoupes en
       `a0="zfs" a1="destroy"`, il n'y a PAS d'espace entre le binaire et son
       verbe dans full_log. Une regex de type `zfs\s+destroy` ne matche jamais.
       On matche donc le binaire en a0 (avec chemin optionnel) puis le verbe
       dans un argument ulterieur quelconque.

       Verbes volontairement limites a la destruction non ambigue. Sont EXCLUS
       `restic forget`, `borg prune`, `duplicity remove` : ce sont les commandes
       de retention, executees par cron sur toute machine correctement
       sauvegardee -> FP quotidien garanti. Un `rm -rf /var/backups` nu est
       exclu pour la meme raison (scripts de menage).
       Reste un FP possible : purge de snapshots planifiee (zfs-auto-snapshot).
       D'ou le niveau 12 et non 15 - le signal a zero FP, c'est le canari. -->
  <rule id="100673" level="12">
    <if_group>audit</if_group>
    <regex type="pcre2">a0="(?:[^"]*/)?(?i:zfs|borg|btrfs|virsh|timeshift|snapper|lvremove)"(?: a\d+="[^"]*")*? a\d+="(?i:destroy|delete|--delete|snapshot-delete)"</regex>
    <description>Inhibition de la restauration : destruction de sauvegardes/snapshots ($(audit.command))</description>
    <mitre>
      <id>T1490</id>
    </mitre>
  </rule>

  <!-- R5 T1490 - desactivation d'un service de sauvegarde. Distinct de 100654
       (services de securite/journalisation), meme logique, meme contrainte de
       format sur les arguments auditd. -->
  <rule id="100674" level="12">
    <if_group>audit</if_group>
    <regex type="pcre2">a0="(?:[^"]*/)?systemctl" a\d+="(?i:disable|stop|mask)"(?: a\d+="[^"]*")*? a\d+="[^"]*(?i:borgmatic|restic|duplicity|bacula|amanda|urbackup|timeshift|rsnapshot|veeam|backup)[^"]*"</regex>
    <description>Inhibition de la restauration : arret/desactivation d'un service de sauvegarde</description>
    <mitre>
      <id>T1490</id>
    </mitre>
  </rule>

  <!-- ==== Destruction massive de donnees (T1485 / T1561) ====
       La regle native 553 ("File deleted", niveau 7) est taggee T1485 mais
       raisonne par fichier : elle ne distingue pas une suppression isolee d'un
       effacement complet. Et notre FIM etant filtre par `restrict`, elle ne se
       declenche de toute facon quasiment jamais.

       Deux angles retenus, meme doctrine que le reste du pack : on ne cherche
       pas le volume (compter les suppressions implique de surveiller /home en
       entier -> le bruit qu'on a refuse), on cherche l'INTENTION non ambigue.

       Angle ecarte : audit des syscalls unlink/unlinkat. Techniquement precis,
       mais chaque fichier temporaire supprime genere un evenement - volume
       ingerable, meme raisonnement que pour clone()/fork() en 100626. -->

  <!-- R6 T1561 - destruction irreversible d'un support. Aucune de ces commandes
       n'a d'usage courant en production : elles apparaissent au provisioning
       (machine neuve, pas encore d'agent Wazuh) ou lors d'un wipe malveillant. -->
  <rule id="100680" level="13">
    <if_group>audit</if_group>
    <regex type="pcre2">a0="(?:[^"]*/)?(?:(?i:wipefs|blkdiscard)"|(?i:mkfs)(?:\.[a-z0-9]+)?"|(?i:shred|dd)"(?: a\d+="[^"]*")*? a\d+="(?:of=)?/dev/(?:sd|nvme|vd|hd|mapper|disk))</regex>
    <description>Destruction de donnees : effacement bas niveau d'un support ($(audit.command))</description>
    <mitre>
      <id>T1561.001</id>
      <id>T1485</id>
    </mitre>
  </rule>

  <!-- R7 T1485 - rm -rf sur une racine systeme ou de donnees. Liste de cibles
       volontairement fermee : un `rm -rf` generique est l'operation la plus
       banale d'un script de build ou de menage, l'alerter revient a alerter en
       continu. On ne matche que les racines dont la suppression n'a aucune
       justification operationnelle.
       Limite assumee : le shell developpe `rm -rf /home/*` AVANT execve, donc
       auditd voit les chemins un par un et cette regle ne matche pas ce cas -
       il est couvert par le canari (100670), qui se trouve precisement dans ces
       repertoires. Les deux regles sont complementaires par construction. -->
  <rule id="100681" level="12">
    <if_group>audit</if_group>
    <regex type="pcre2">a0="(?:[^"]*/)?rm"(?: a\d+="[^"]*")*? a\d+="-[a-zA-Z]*[rR][a-zA-Z]*"(?: a\d+="[^"]*")*? a\d+="/(?:|home|srv|etc|boot|data|opt|var|var/www|var/lib|var/lib/mysql|var/lib/postgresql|var/backups)/?"</regex>
    <description>Destruction de donnees : suppression recursive d'une racine systeme ($(audit.command))</description>
    <mitre>
      <id>T1485</id>
    </mitre>
  </rule>

  <!-- R8 T1485/T1486 - correlation : plusieurs canaris touches dans une fenetre
       courte. Un canari isole peut theoriquement etre une manipulation humaine
       maladroite ; trois canaris dans des repertoires differents en 2 min, non.
       C'est la signature d'un parcours recursif automatise - chiffrement ou
       effacement de masse en cours, et non un incident ponctuel.
       Pas de <same_field> ici : teste, il casse le comptage de frequence
       (cf. README, meme piege que sur 100658). -->
  <rule id="100682" level="15" frequency="3" timeframe="120">
    <if_matched_sid>100670</if_matched_sid>
    <description>Destruction/chiffrement de masse confirme : 3+ canaris alteres en 2 min</description>
    <mitre>
      <id>T1485</id>
      <id>T1486</id>
    </mitre>
  </rule>

</group>

<!-- ==========================================================================
     Brute force SSH REUSSI (T1110 -> T1078)

     Trou de detection du ruleset par defaut : il sait dire "on brute force"
     (5720, 5763) et "quelqu'un s'est connecte" (5715), mais jamais "celui qui
     brute forcait vient d'entrer". Or c'est le seul des trois qui est un
     incident : les deux autres sont du bruit de fond sur toute machine exposee.

     On correle sur les echecs bruts et non sur 5763/5712 (le brute force deja
     qualifie) : ces deux regles portent ignore="60", donc apres declenchement
     elles restent muettes 60s - exactement la fenetre pendant laquelle le succes
     a le plus de chances de tomber. Chainer dessus perdrait le cas nominal.

     Deux regles jumelles, une par sid d'echec, parce que les deux syntaxes plus
     compactes ont ete testees et ne fonctionnent PAS (verifie en logtest, le cas
     nominal cessait de declencher) :
       - <if_matched_group>authentication_failed</if_matched_group> : ne matche
         jamais, meme quand les echecs viennent bien de ce groupe.
       - <if_matched_sid>5710,5760</if_matched_sid> : la liste n'est pas parsee,
         if_matched_sid n'accepte qu'un seul sid.
     Il FAUT couvrir les deux sids : un brute force sur compte inexistant sort en
     5710 et non en 5760, or c'est le scenario le plus courant (l'attaquant essaie
     admin/root/test, puis tombe sur un compte valide). Ne chainer que sur 5760
     rate ce cas - c'etait le trou de la premiere version.

     Double alerte possible si les deux compteurs franchissent le seuil sur le
     meme incident : assume, deux alertes valent mieux qu'un scenario manque.

     Pas de correlation sur le compte (same_field srcuser) : elle casse le
     comptage de frequence (meme piege que 100658/100682, cf. README). On reste
     donc au niveau IP - un attaquant qui echoue sur `admin` puis reussit sur
     `backup` depuis la meme IP declenche quand meme, ce qui est le comportement
     voulu (password spraying).
     ========================================================================== -->
<group name="authentication,ssh,threat_hunting,">

  <!-- Echecs sur comptes EXISTANTS (5760) puis succes -->
  <rule id="100690" level="14" frequency="5" timeframe="300">
    <if_sid>5715</if_sid>
    <if_matched_sid>5760</if_matched_sid>
    <same_source_ip />
    <description>Brute force SSH REUSSI : authentification acceptee depuis une IP en echec repete ($(srcip) -> compte $(dstuser))</description>
    <mitre>
      <id>T1110</id>
      <id>T1078</id>
    </mitre>
    <group>authentication_success,attack,</group>
  </rule>

  <!-- Echecs sur comptes INEXISTANTS (5710) puis succes = enumeration de comptes
       suivie d'une connexion valide. Signal plus fort que 100690 : l'attaquant a
       devine le nom de compte en meme temps que le mot de passe. -->
  <rule id="100691" level="14" frequency="5" timeframe="300">
    <if_sid>5715</if_sid>
    <if_matched_sid>5710</if_matched_sid>
    <same_source_ip />
    <description>Brute force SSH REUSSI apres enumeration de comptes : succes depuis une IP ayant teste des comptes inexistants ($(srcip) -> compte $(dstuser))</description>
    <mitre>
      <id>T1110</id>
      <id>T1078</id>
      <id>T1589.001</id>
    </mitre>
    <group>authentication_success,attack,</group>
  </rule>

</group>
