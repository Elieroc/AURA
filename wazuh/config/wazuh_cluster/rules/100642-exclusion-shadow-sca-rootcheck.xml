<!-- SOC-AI - rule 100642 (level 0). Domain: threat_hunting,linux,mitre_gaps,
     Naming convention and load-order trap: see rules/README.md -->
<group name="threat_hunting,linux,mitre_gaps,">

  <!-- Exclusion for 100653: the Wazuh agent's SCA / rootcheck checks inspect the
       permissions of /etc/shadow (CIS Debian policies) on every scan. The binary
       lives under /var/ossec, which is never an attacker's doing without
       100710/100711 flagging that execution path first. -->

  <rule id="100642" level="0">
    <if_sid>100653</if_sid>
    <field name="audit.exe" type="pcre2">^/var/ossec/</field>
    <description>Exclusion 100653: Wazuh agent SCA/rootcheck check</description>
  </rule>

</group>
