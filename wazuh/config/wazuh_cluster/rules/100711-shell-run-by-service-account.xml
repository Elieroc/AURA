<!-- SOC-AI - rule 100711 (level 12). Domain: audit,web_attack,web_shell,
     Naming convention and load-order trap: see rules/README.md -->
<group name="audit,web_attack,web_shell,">

  <!-- T1190/T1059 - a SHELL executed by any service account.
       Closes the blind spot of 100710, which hardcoded euid=33: an RCE on
       PostgreSQL (COPY TO PROGRAM), MySQL (UDF), Redis (module), Tomcat or a
       dedicated php-fpm pool would have triggered nothing. The generic signal is
       "a service account obtained an interpreter", whatever the compromised
       service is.

       Scope: euid 1-999 = the system account range on Debian (human accounts
       start at 1000, root is 0 and excluded by the lower bound). `nobody`
       (65534) is out of range on purpose: it is the fallback uid of many mounts
       and watching it is too noisy.

       Constraint on exe: interpreters only. A service account running its own
       binary is normal; running a shell is not. Without that constraint the rule
       would alert on every systemd ExecStartPre.

       Expected FPs, still to be measured: PostgreSQL archive_command, backup
       hooks, cron jobs running under a service account. Those are recurrent and
       have a stable signature -> absorbed by the automatic whitelist
       (soc_agent.whitelist) rather than by a hardcoded exclusion here. -->

  <rule id="100711" level="12">
    <if_group>audit</if_group>
    <field name="audit.euid" type="pcre2">^(?:[1-9]|[1-9][0-9]|[1-9][0-9][0-9])$</field>
    <field name="audit.exe" type="pcre2">/(?:sh|bash|dash|zsh|ksh|ash|busybox|python[0-9.]*|perl|php|ruby|node|lua|tclsh|awk|gawk|mawk|nc|ncat|netcat|socat|curl|wget)$</field>
    <description>Probable service account compromise: interpreter ($(audit.exe)) run as euid=$(audit.euid) - $(audit.command)</description>
    <mitre>
      <id>T1190</id>
      <id>T1059</id>
    </mitre>
    <group>command_execution,</group>
  </rule>

</group>
