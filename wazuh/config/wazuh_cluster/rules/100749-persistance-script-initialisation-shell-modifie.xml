<!-- SOC-AI - regle 100749 (niveau 12). Domaine : persistence,threat_hunting,linux,syscheck,
     Convention et piege d ordre de chargement : voir rules/README.md -->
<group name="persistence,threat_hunting,linux,syscheck,">

  <!-- T1546.004 - persistance par shell d'initialisation. -->

  <rule id="100749" level="12">
    <if_group>syscheck</if_group>
    <field name="file" type="pcre2">^/etc/(?:profile$|bash\.bashrc$|profile\.d/)</field>
    <description>Persistance : script d'initialisation de shell modifie ($(file))</description>
    <mitre><id>T1546.004</id></mitre>
  </rule>

</group>
