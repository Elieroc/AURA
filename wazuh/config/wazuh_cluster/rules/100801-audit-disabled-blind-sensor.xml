<!-- SOC-AI - rule 100801 (level 13). Domain: soc_selfcheck,wazuh,
     Naming convention and load-order trap: see rules/README.md -->
<group name="soc_selfcheck,wazuh,">

  <!-- Kernel audit disabled, or auditctl unreachable (empty value). The `\b`
       after the 0 avoids matching a future `audit_enabled=01`. -->

  <rule id="100801" level="13">
    <if_sid>100800</if_sid>
    <match type="pcre2">audit_enabled=(?:0\b|\s|$)</match>
    <description>Blind sensor: kernel audit disabled - every auditd rule (1006xx/1007xx) is inert</description>
    <mitre>
      <id>T1562.001</id>
      <id>T1562.006</id>
    </mitre>
  </rule>

</group>
