<!-- SOC-AI - regle 100742 (niveau 12). Domaine : persistence,threat_hunting,linux,syscheck,
     Convention et piege d ordre de chargement : voir rules/README.md -->
<group name="persistence,threat_hunting,linux,syscheck,">

  <!-- T1543.002 - service ou timer systemd. Vecteur de persistance le plus
       courant sur Linux moderne, et le plus discret : un `.service` avec
       Restart=always redemarre l'implant a chaque kill. -->

  <rule id="100742" level="12">
    <if_group>syscheck</if_group>
    <field name="file" type="pcre2">^/(?:etc|lib|usr/lib)/systemd/system/</field>
    <description>Persistance : unit systemd deposee ou modifiee ($(file))</description>
    <mitre>
      <id>T1543.002</id>
      <id>T1053.006</id>
    </mitre>
  </rule>

</group>
