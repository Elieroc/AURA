<!-- SOC-AI - rule 100621 (level 3). Domain: abuseipdb,threat_intel,
     Naming convention and load-order trap: see rules/README.md -->
<group name="abuseipdb,threat_intel,">

  <!-- AbuseIPDB enrichment received (any response) -->

  <rule id="100621" level="3">
    <decoded_as>json</decoded_as>
    <field name="integration">custom-abuseipdb</field>
