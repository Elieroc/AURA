<!-- SOC-AI - rule 100765 (level 12). Domain: threat_hunting,linux,post_exploitation,
     Naming convention and load-order trap: see rules/README.md -->
<group name="threat_hunting,linux,post_exploitation,">

  <!-- T1105 - a download piped straight into an interpreter (`curl ... | bash`).
       The pipe implies a space, so the whole argument is hex-encoded by auditd -
       we match both forms:
         7C2062617368 = "| bash",  7C207368 = "| sh"
       `-o /dev/stdout` and the `$(curl ...)` substitution are covered by the same
       downloader + interpreter co-occurrence logic. -->

  <rule id="100765" level="12">
    <if_group>audit</if_group>
    <field name="audit.key" type="pcre2">^audit-wazuh-c$</field>
    <regex type="pcre2">(?i)(?:curl|wget|fetch)[^\n]{0,200}?\|\s*(?:ba|z|k|da)?sh\b|(?:6375726C|77676574)[0-9A-F]*?7C20(?:62617368|7368|7A7368)</regex>
    <description>Ingress tool transfer: download executed straight by an interpreter ($(audit.command))</description>
    <mitre>
      <id>T1105</id>
      <id>T1059.004</id>
    </mitre>
  </rule>

</group>
