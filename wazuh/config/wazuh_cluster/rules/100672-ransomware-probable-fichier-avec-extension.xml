<!-- SOC-AI - regle 100672 (niveau 14). Domaine : ransomware,threat_hunting,linux,
     Convention et piege d ordre de chargement : voir rules/README.md -->
<group name="ransomware,threat_hunting,linux,">

  <!-- R3 T1486 - extension de chiffrement connue apposee sur un fichier.
       Scope restreint aux extensions sans usage legitime (pas de .enc/.aes :
       utilises par des outils d'admin). -->

  <rule id="100672" level="14">
    <if_group>syscheck</if_group>
    <field name="file" type="pcre2">(?i)\.(locky|lockbit|conti|ryuk|revil|sodinokibi|djvu|wncry|wannacry|crysis|phobos|makop|mallox|blackcat|royal|akira|basta|8base|cuba|hive|nokoyawa|encrypted|crypted|cryptolocker|kraken|onion|payransom)$</field>
    <description>Ransomware probable : fichier avec extension de chiffrement connue ($(file))</description>
    <mitre>
      <id>T1486</id>
    </mitre>
  </rule>

</group>
