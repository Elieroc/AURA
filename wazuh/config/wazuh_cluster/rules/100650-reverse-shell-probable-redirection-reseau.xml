<!-- SOC-AI - regle 100650 (niveau 12). Domaine : threat_hunting,linux,mitre_gaps,
     Convention et piege d ordre de chargement : voir rules/README.md -->
<group name="threat_hunting,linux,mitre_gaps,">

  <!-- R1 T1059.004 - reverse shell / redirection reseau via /dev/tcp|/dev/udp (bash).
       IMPORTANT (validé live) : le payload d'un `bash -c '...'` contient un espace donc
       auditd HEX-encode l'argument entier -> /dev/tcp n'apparait PAS en clair. On matche
       donc aussi la signature hex : 2F6465762F746370 = "/dev/tcp", ...756470 = "/dev/udp".
       (Le cas clair reste utile si /dev/tcp/... est un argument isole sans espace.) -->

  <rule id="100650" level="12">
    <if_group>audit</if_group>
    <regex type="pcre2">(?i)/dev/(tcp|udp)/|2F6465762F(746370|756470)</regex>
    <description>Reverse shell probable : redirection reseau via /dev/tcp|/dev/udp</description>
    <mitre><id>T1059.004</id></mitre>
  </rule>

</group>
