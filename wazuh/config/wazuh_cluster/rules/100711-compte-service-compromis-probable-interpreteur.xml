<!-- SOC-AI - regle 100711 (niveau 12). Domaine : audit,web_attack,web_shell,
     Convention et piege d ordre de chargement : voir rules/README.md -->
<group name="audit,web_attack,web_shell,">

  <!-- T1190/T1059 - execution d'un SHELL par un compte de service quelconque.
       Comble l'angle mort de 100710, qui codait euid=33 en dur : une RCE sur
       PostgreSQL (COPY TO PROGRAM), MySQL (UDF), Redis (module), Tomcat ou un
       pool php-fpm dedie n'aurait rien declenche. Le signal generique est
       « un compte de service a obtenu un interpreteur », independamment du
       service compromis.

       Perimetre : euid 1-999 = plage des comptes systeme sous Debian (les
       comptes humains commencent a 1000, root est 0 et exclu par la borne
       inferieure). `nobody` (65534) est hors plage, volontairement : c'est l'uid
       de repli de nombreux montages et sa surveillance est trop bruyante.

       Contrainte sur l'exe : uniquement les interpreteurs. Un compte de service
       qui execute son propre binaire est la normale ; qui execute un shell ne
       l'est pas. Sans cette contrainte la regle alerterait sur chaque
       ExecStartPre de systemd.

       FP attendus a mesurer : archive_command PostgreSQL, hooks de sauvegarde,
       jobs cron tournant sous un compte de service. Ces cas sont recurrents et
       de signature stable -> absorbes par la whitelist automatique
       (soc_agent.whitelist) plutot que par une exclusion figee ici. -->

  <rule id="100711" level="12">
    <if_group>audit</if_group>
    <field name="audit.euid" type="pcre2">^(?:[1-9]|[1-9][0-9]|[1-9][0-9][0-9])$</field>
    <field name="audit.exe" type="pcre2">/(?:sh|bash|dash|zsh|ksh|ash|busybox|python[0-9.]*|perl|php|ruby|node|lua|tclsh|awk|gawk|mawk|nc|ncat|netcat|socat|curl|wget)$</field>
    <description>Compte de service compromis probable : interpreteur ($(audit.exe)) execute en euid=$(audit.euid) - $(audit.command)</description>
    <mitre>
      <id>T1190</id>
      <id>T1059</id>
    </mitre>
    <group>command_execution,</group>
  </rule>

</group>
