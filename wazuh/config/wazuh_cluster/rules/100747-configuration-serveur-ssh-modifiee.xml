<!-- SOC-AI - regle 100747 (niveau 12). Domaine : persistence,threat_hunting,linux,syscheck,
     Convention et piege d ordre de chargement : voir rules/README.md -->
<group name="persistence,threat_hunting,linux,syscheck,">

  <!-- T1098.004 - configuration SSH serveur (PermitRootLogin yes, AuthorizedKeys
       File detourne, ForceCommand). -->

  <rule id="100747" level="12">
    <if_group>syscheck</if_group>
    <field name="file" type="pcre2">^/etc/ssh/sshd_config</field>
    <description>Configuration du serveur SSH modifiee ($(file))</description>
    <mitre><id>T1098.004</id></mitre>
  </rule>

</group>
