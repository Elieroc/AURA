<!--
  LSASS credential dumping (T1003.001): a process opens lsass.exe with access
  rights that allow reading its memory (Sysmon event 10, ProcessAccess). Tools
  (mimikatz sekurlsa, procdump, comsvcs.dll MiniDump, task manager dump) request
  PROCESS_VM_READ | PROCESS_QUERY_INFORMATION. Common malicious masks:
    0x1010 0x1410 0x1438 0x143a 0x1fffff (full) — mimikatz/procdump/comsvcs.

  Requires Sysmon EID 10 (kept enabled; only ImageLoad/DnsQuery/FileCreateStreamHash
  were trimmed for noise). No rule flagged lsass access before.
-->
<group name="windows,sysmon,attack,">

  <rule id="100918" level="12">
    <decoded_as>json</decoded_as>
    <field name="win.system.eventID">^10$</field>
    <field name="win.eventdata.targetImage">lsass.exe$</field>
    <field name="win.eventdata.grantedAccess">^0x1010$|^0x1410$|^0x1438$|^0x143a$|^0x1fffff$|^0x1f1fff$|^0x1f2fff$</field>
    <description>Credential dumping: lsass.exe opened with memory-read access by $(win.eventdata.sourceImage)</description>
    <mitre>
      <id>T1003.001</id>
    </mitre>
    <group>credential_access,lsass_dump,pci_dss_10.6.1,</group>
  </rule>

  <!-- Known-benign accessors of lsass (AV/EDR/system components). Tune per site. -->
  <rule id="100919" level="0">
    <if_sid>100918</if_sid>
    <field name="win.eventdata.sourceImage">\\\\wbem\\\\WmiPrvSE.exe$|\\\\MsMpEng.exe$|\\\\MpDefenderCoreService.exe$|\\\\csrss.exe$|\\\\wininit.exe$</field>
    <description>lsass access by a known system/security process (expected)</description>
    <group>lsass_dump,</group>
  </rule>

</group>
