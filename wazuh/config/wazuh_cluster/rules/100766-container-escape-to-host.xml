<!-- SOC-AI - rule 100766 (level 13). Domain: threat_hunting,linux,post_exploitation,
     Naming convention and load-order trap: see rules/README.md -->
<group name="threat_hunting,linux,post_exploitation,">

  <!-- T1611 - container escape / host takeover. A privileged container, a mount
       of the host root, access to the Docker socket or `nsenter -t 1` all grant
       root on the host from inside a container.
       Equally valid the other way round: on an already compromised host, these
       are the commands that turn container access into full host access. -->

  <rule id="100766" level="13">
    <if_group>audit</if_group>
    <field name="audit.key" type="pcre2">^audit-wazuh-c$</field>
    <regex type="pcre2">(?i)a\d+="--privileged"|a\d+="(?:[^"]*/)?nsenter"[^\n]*?a\d+="-[a-zA-Z]*t[a-zA-Z]*"\s+a\d+="1"|a\d+="[^"]*/var/run/docker\.sock[^"]*"|a\d+="-v"\s+a\d+="/:/[^"]*"|a\d+="--pid=host"|a\d+="--net=host"[^\n]*?a\d+="--privileged"</regex>
    <description>Container escape: privileged host access requested ($(audit.command))</description>
    <mitre>
      <id>T1611</id>
      <id>T1610</id>
    </mitre>
  </rule>

</group>
