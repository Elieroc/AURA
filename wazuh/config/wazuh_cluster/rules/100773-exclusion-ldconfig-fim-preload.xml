<!-- SOC-AI - rule 100773 (level 0). Domain: threat_hunting,linux,post_exploitation,
     Naming convention and load-order trap: see rules/README.md -->
<group name="threat_hunting,linux,post_exploitation,">

  <!-- Exclusion for 100772: the FIM reads the file to hash it, and
       ldconfig/dpkg/apt touch the loader configuration during normal package
       operations. -->

  <rule id="100773" level="0">
    <if_sid>100772</if_sid>
    <field name="audit.exe" type="pcre2">^/var/ossec/|/(?:dpkg|apt|apt-get|ldconfig)$</field>
    <description>Exclusion 100772: read by the FIM or ldconfig cache update</description>
  </rule>

</group>
