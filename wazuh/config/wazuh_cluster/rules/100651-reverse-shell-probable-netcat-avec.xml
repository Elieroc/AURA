<!-- SOC-AI - regle 100651 (niveau 12). Domaine : threat_hunting,linux,mitre_gaps,
     Convention et piege d ordre de chargement : voir rules/README.md -->
<group name="threat_hunting,linux,mitre_gaps,">

  <!-- R2 T1059.004 - netcat/ncat avec exec (-e / -c). -->

  <rule id="100651" level="12">
    <if_group>audit</if_group>
    <field name="audit.exe" type="pcre2">/(nc|ncat|netcat)(\.\w+)?$</field>
    <regex type="pcre2">a\d+=\"-(e|c)\"</regex>
    <description>Reverse shell probable : netcat avec option d'execution (-e/-c)</description>
    <mitre><id>T1059.004</id></mitre>
  </rule>

</group>
