<!-- Aura-SOC - rule 100646 (level 0). Domain: threat_hunting,linux,mitre_gaps,
     Naming convention and load-order trap: see rules/README.md -->
<group name="threat_hunting,linux,mitre_gaps,">

  <!-- Exclusion for 100645: the SOC active responses drive nftables by design
       (isolation and un-isolation). Their parent is the AR script, not an
       attacker's shell. -->

  <rule id="100646" level="0">
    <if_sid>100645</if_sid>
    <regex type="pcre2">host-(?:un)?isolate|66697265776</regex>
    <description>Exclusion 100645: nftables driven by a Aura-SOC active response</description>
  </rule>

</group>
