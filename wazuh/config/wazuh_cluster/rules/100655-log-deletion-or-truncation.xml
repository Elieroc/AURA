<!-- SOC-AI - rule 100655 (level 10). Domain: threat_hunting,linux,mitre_gaps,
     Naming convention and load-order trap: see rules/README.md -->
<group name="threat_hunting,linux,mitre_gaps,">

  <!-- R6 T1070.002 - log destruction (rm/shred/truncate against /var/log). -->

  <rule id="100655" level="10">
    <if_group>audit</if_group>
    <field name="audit.exe" type="pcre2">/(rm|shred|truncate|unlink)$</field>
    <regex type="pcre2">/var/log/(auth|syslog|secure|audit|wazuh|messages|journal)</regex>
    <description>Defense evasion: log files deleted or truncated ($(audit.command))</description>
    <mitre><id>T1070.002</id></mitre>
  </rule>

</group>
