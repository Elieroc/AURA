<!-- SOC-AI - regle 100766 (niveau 13). Domaine : threat_hunting,linux,post_exploitation,
     Convention et piege d ordre de chargement : voir rules/README.md -->
<group name="threat_hunting,linux,post_exploitation,">

  <!-- T1611 - evasion de conteneur / prise de controle de l'hote. Un conteneur
       privilegie, un montage de la racine de l'hote, l'acces au socket Docker
       ou `nsenter -t 1` donnent root sur l'hote depuis un conteneur.
       Egalement valable dans l'autre sens : sur un hote deja compromis, ce sont
       les commandes qui transforment un acces conteneur en acces hote complet. -->

  <rule id="100766" level="13">
    <if_group>audit</if_group>
    <field name="audit.key" type="pcre2">^audit-wazuh-c$</field>
    <regex type="pcre2">(?i)a\d+="--privileged"|a\d+="(?:[^"]*/)?nsenter"[^\n]*?a\d+="-[a-zA-Z]*t[a-zA-Z]*"\s+a\d+="1"|a\d+="[^"]*/var/run/docker\.sock[^"]*"|a\d+="-v"\s+a\d+="/:/[^"]*"|a\d+="--pid=host"|a\d+="--net=host"[^\n]*?a\d+="--privileged"</regex>
    <description>Evasion de conteneur : acces privilegie a l'hote demande ($(audit.command))</description>
    <mitre>
      <id>T1611</id>
      <id>T1610</id>
    </mitre>
  </rule>

</group>
