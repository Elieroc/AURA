<!-- SOC-AI - regle 100772 (niveau 14). Domaine : threat_hunting,linux,post_exploitation,
     Convention et piege d ordre de chargement : voir rules/README.md -->
<group name="threat_hunting,linux,post_exploitation,">

  <!-- T1574.006 - ecriture sur /etc/ld.so.preload vue par auditd. Doublon
       assume avec le FIM 100748 : c'est la detection la plus critique du pack
       (rootkit userland capable de masquer les collecteurs du SOC eux-memes) et
       le FIM s'est montre intermittent. Deux canaux independants, volontairement.
       PREREQUIS : le fichier doit EXISTER, meme vide. inotify comme les watches
       auditd ciblent un inode : sur un chemin absent, ni le FIM ni auditd ne
       posent quoi que ce soit, et la creation du fichier passe inapercue. C'est
       pourquoi scripts/install-agent.sh cree un /etc/ld.so.preload vide. -->

  <rule id="100772" level="14">
    <if_group>audit</if_group>
    <field name="audit.key" type="pcre2">^audit-wazuh-preload$</field>
    <description>Rootkit probable : ecriture sur $(audit.file.name) par $(audit.exe)</description>
    <mitre><id>T1574.006</id></mitre>
  </rule>

</group>
