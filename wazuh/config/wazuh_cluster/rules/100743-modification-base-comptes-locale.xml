<!-- SOC-AI - regle 100743 (niveau 12). Domaine : persistence,threat_hunting,linux,syscheck,
     Convention et piege d ordre de chargement : voir rules/README.md -->
<group name="persistence,threat_hunting,linux,syscheck,">

  <!-- T1136 - base comptes. Niveau 12 : une modification de /etc/passwd ou
       /etc/group est notable mais legitime (creation de compte de service par
       un paquet). C'est 100744 qui porte le signal fort. -->

  <rule id="100743" level="12">
    <if_group>syscheck</if_group>
    <field name="file" type="pcre2">^/etc/(?:passwd|group)$</field>
    <description>Modification de la base de comptes locale ($(file))</description>
    <mitre><id>T1136.001</id></mitre>
  </rule>

</group>
