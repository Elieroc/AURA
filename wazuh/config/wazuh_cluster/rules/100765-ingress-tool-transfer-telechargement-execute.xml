<!-- SOC-AI - regle 100765 (niveau 12). Domaine : threat_hunting,linux,post_exploitation,
     Convention et piege d ordre de chargement : voir rules/README.md -->
<group name="threat_hunting,linux,post_exploitation,">

  <!-- T1105 - telechargement pipe directement dans un interpreteur
       (`curl ... | bash`). Le pipe implique un espace, donc l'argument complet
       est hex-encode par auditd - on matche les deux formes :
         7C2062617368 = "| bash",  7C207368 = "| sh"
       Le `-o /dev/stdout` et la substitution `$(curl ...)` sont couverts par la
       meme logique de co-occurrence telechargeur + interpreteur. -->

  <rule id="100765" level="12">
    <if_group>audit</if_group>
    <field name="audit.key" type="pcre2">^audit-wazuh-c$</field>
    <regex type="pcre2">(?i)(?:curl|wget|fetch)[^\n]{0,200}?\|\s*(?:ba|z|k|da)?sh\b|(?:6375726C|77676574)[0-9A-F]*?7C20(?:62617368|7368|7A7368)</regex>
    <description>Ingress tool transfer : telechargement execute directement par un interpreteur ($(audit.command))</description>
    <mitre>
      <id>T1105</id>
      <id>T1059.004</id>
    </mitre>
  </rule>

</group>
