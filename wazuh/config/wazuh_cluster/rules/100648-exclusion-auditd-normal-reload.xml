<!-- SOC-AI - rule 100648 (level 0). Domain: threat_hunting,linux,mitre_gaps,
     Naming convention and load-order trap: see rules/README.md -->
<group name="threat_hunting,linux,mitre_gaps,">

  <!-- Exclusion for 100647: augenrules/auditctl rewrite /etc/audit/audit.rules
       on every `augenrules load` (including at boot through the auditd service).
       That is normal operation, not tampering. -->

  <rule id="100648" level="0">
    <if_sid>100647</if_sid>
    <field name="audit.exe" type="pcre2">/(?:augenrules|auditctl|auditd|dpkg|apt|apt-get|systemd(?:-\w+)?)$</field>
    <description>Exclusion 100647: normal auditd rule reload / package update</description>
  </rule>

</group>
