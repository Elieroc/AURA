<group name="local,npm-proxy,">
  <rule id="100820" level="0">
    <decoded_as>npm-access</decoded_as>
    <description>Nginx Proxy Manager access grouped.</description>
  </rule>

  <rule id="100821" level="5">
    <if_sid>100820</if_sid>
    <field name="http_status">^4</field>
    <description>Nginx Proxy Manager: client error ($(http_status)) on $(server)$(uri).</description>
    <group>web_scan,</group>
  </rule>

  <rule id="100822" level="7">
    <if_sid>100820</if_sid>
    <field name="http_status">^5</field>
    <description>Nginx Proxy Manager: upstream/server error ($(http_status)) on $(server)$(uri).</description>
  </rule>

  <rule id="100823" level="10" frequency="12" timeframe="60" ignore="120">
    <if_matched_sid>100821</if_matched_sid>
    <same_source_ip />
    <description>Nginx Proxy Manager: multiple client errors from same source (scan probable).</description>
    <mitre>
      <id>T1595</id>
    </mitre>
    <group>web_scan,</group>
  </rule>
</group>
