<!-- SOC-AI - regle 100801 (niveau 13). Domaine : soc_selfcheck,wazuh,
     Convention et piege d ordre de chargement : voir rules/README.md -->
<group name="soc_selfcheck,wazuh,">

  <!-- Audit noyau desactive, ou auditctl injoignable (valeur vide). Le `\b` sur
       le 0 evite de matcher un futur `audit_enabled=01`. -->

  <rule id="100801" level="13">
    <if_sid>100800</if_sid>
    <match type="pcre2">audit_enabled=(?:0\b|\s|$)</match>
    <description>Capteur aveugle : audit noyau desactive - toutes les regles auditd (1006xx/1007xx) sont inoperantes</description>
    <mitre>
      <id>T1562.001</id>
      <id>T1562.006</id>
    </mitre>
  </rule>

</group>
