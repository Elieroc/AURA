<!-- SOC-AI - regle 100761 (niveau 12). Domaine : threat_hunting,linux,post_exploitation,
     Convention et piege d ordre de chargement : voir rules/README.md -->
<group name="threat_hunting,linux,post_exploitation,">

  <!-- T1136.001 / T1098 - creation de compte ou ajout a un groupe privilegie.
       La regle native 5902 couvre le cas via syslog ; celle-ci ajoute le
       contexte auditd (utilisateur d'origine, commande complete) et surtout
       fonctionne meme si le compte est cree sans passer par le journal. -->

  <rule id="100761" level="12">
    <if_group>audit</if_group>
    <field name="audit.key" type="pcre2">^audit-wazuh-c$</field>
    <regex type="pcre2">a\d+="(?:[^"]*/)?(?i:useradd|adduser|usermod|gpasswd|newusers)"[^\n]*?a\d+="[^"]*(?i:sudo|wheel|admin|docker|adm|shadow|root)[^"]*"</regex>
    <description>Elevation de privileges : compte ajoute a un groupe privilegie ($(audit.command))</description>
    <mitre>
      <id>T1136.001</id>
      <id>T1098</id>
    </mitre>
  </rule>

</group>
