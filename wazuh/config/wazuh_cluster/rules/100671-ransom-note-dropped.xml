<!-- SOC-AI - rule 100671 (level 14). Domain: ransomware,threat_hunting,linux,
     Naming convention and load-order trap: see rules/README.md -->
<group name="ransomware,threat_hunting,linux,">

  <!-- R2 T1486 - ransom note dropped. Deliberately specific patterns: `README`
       on its own is far too common under /home and /srv -> excluded.
       Covers STOP/Djvu (_readme.txt), LockBit, Conti, Hive, Royal, Akira. -->

  <rule id="100671" level="14">
    <if_group>syscheck</if_group>
    <field name="file" type="pcre2">(?i)(_readme\.txt|how[_ -]?to[_ -]?(decrypt|restore|recover)|(decrypt|restore|recover)[_ -]?(your[_ -]?)?files|readme[_-]for[_-]decrypt|!+[_ -]?restore|ransom[_ -]?note|akira_readme|recover[_-]?your[_-]?data)</field>
    <description>Probable ransomware: ransom note dropped ($(file))</description>
    <mitre>
      <id>T1486</id>
    </mitre>
  </rule>

</group>
