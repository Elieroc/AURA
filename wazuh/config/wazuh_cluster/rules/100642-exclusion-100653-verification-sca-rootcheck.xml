<!-- SOC-AI - regle 100642 (niveau 0). Domaine : threat_hunting,linux,mitre_gaps,
     Convention et piege d ordre de chargement : voir rules/README.md -->
<group name="threat_hunting,linux,mitre_gaps,">

  <!-- Exclusion 100653 : les checks SCA / rootcheck de l'agent Wazuh inspectent
       les permissions de /etc/shadow (politiques CIS Debian) a chaque scan. Le
       binaire est sous /var/ossec, jamais le fait d'un attaquant qui aurait
       obtenu ce chemin d'execution sans que 100710/100711 le signalent d'abord. -->

  <rule id="100642" level="0">
    <if_sid>100653</if_sid>
    <field name="audit.exe" type="pcre2">^/var/ossec/</field>
    <description>Exclusion 100653 : verification SCA/rootcheck de l'agent Wazuh</description>
  </rule>

</group>
