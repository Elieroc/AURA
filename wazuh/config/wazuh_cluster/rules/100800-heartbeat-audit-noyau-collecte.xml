<!-- SOC-AI - regle 100800 (niveau 0). Domaine : soc_selfcheck,wazuh,
     Convention et piege d ordre de chargement : voir rules/README.md -->
<group name="soc_selfcheck,wazuh,">

  <!-- Base : la sortie du heartbeat. Niveau 0 - c'est la normale, une fois
       toutes les 5 min par agent.
       Il FAUT chainer sur 530 (`decoded_as ossec` + `match "ossec: output:"`,
       niveau 0, groupe process_monitor) : teste en logtest, une regle autonome
       avec un simple <match> perd l'arbitrage face a 530, qui capte toute sortie
       de <localfile><command> et gagne. C'est le meme schema que la regle native
       533 (netstat). On ne matche pas sur <location> : l'alias remonte
       differemment selon la version. -->

  <rule id="100800" level="0">
    <if_sid>530</if_sid>
    <match>audit_enabled=</match>
    <description>Heartbeat de l'audit noyau collecte</description>
  </rule>

</group>
