<!-- SOC-AI - regle 100626 (niveau 12). Domaine : threat_hunting,linux,
     Convention et piege d ordre de chargement : voir rules/README.md -->
<group name="threat_hunting,linux,">

  <!-- Fork bomb : épuisement de la table de process (ulimit -u / nproc). Détection via
            le message d'erreur émis par le noyau/PAM/le shell quand la limite est atteinte -
            plus fiable et bien moins bruyant qu'auditer clone()/fork() en direct (des millions
            d'événements légitimes par jour). -->
       <!-- REVISION 2026-07-26 : ajout des signatures cgroup v2. Sur un systemd
            moderne, la limite atteinte en premier n'est presque jamais `ulimit -u`
            mais `TasksMax` du cgroup de l'unite ou de la session : le noyau emet
            alors "cgroup: fork rejected by pids controller" et systemd
            "Failed to fork off ... Resource temporarily unavailable". L'ancienne
            regex ne couvrait que la forme shell/PAM et ratait donc le cas le plus
            courant sur Debian 12.
            Pas d'`if_group`/`if_sid` : ces messages arrivent selon le cas via le
            noyau, PAM, systemd ou le shell, decodes dans des groupes differents.
            Restreindre a un groupe reintroduirait un angle mort - le cout d'une
            evaluation PCRE2 supplementaire par log est le prix assume. -->

  <rule id="100626" level="12">
    <match type="pcre2">(?i)(fork:\s*(retry:\s*)?resource temporarily unavailable|too many processes|clone\(\) failed|fork rejected by pids controller|cgroup:\s*fork rejected|failed to fork off[^\n]{0,60}resource temporarily unavailable|can'?t fork|fork failed)</match>
    <description>Épuisement de la table de process (message noyau/PAM/systemd/shell) - signature de fork bomb</description>
    <mitre>
      <id>T1499.001</id>
    </mitre>
  </rule>

</group>
