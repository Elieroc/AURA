<!-- SOC-AI - regle 100748 (niveau 14). Domaine : persistence,threat_hunting,linux,syscheck,
     Convention et piege d ordre de chargement : voir rules/README.md -->
<group name="persistence,threat_hunting,linux,syscheck,">

  <!-- T1574.006 - detournement du chargeur dynamique. Niveau 14 : /etc/ld.so.preload
       n'existe PAS sur un Debian sain. Sa creation est le mecanisme de
       persistance des rootkits userland (Azazel, Bedevil, HiddenWasp) et permet
       de masquer processus et fichiers a tous les outils du systeme, y compris
       aux collecteurs du SOC. Zero faux positif attendu. -->

  <rule id="100748" level="14">
    <if_group>syscheck</if_group>
    <field name="file" type="pcre2">^/etc/ld\.so\.preload$|^/etc/ld\.so\.conf\.d/</field>
    <description>Rootkit probable : detournement du chargeur dynamique ($(file))</description>
    <mitre><id>T1574.006</id></mitre>
  </rule>

</group>
