<!-- SOC-AI - regle 100629 (niveau 0). Domaine : threat_hunting,linux,
     Convention et piege d ordre de chargement : voir rules/README.md -->
<group name="threat_hunting,linux,">

  <!-- Exclusion /tmp/ansible-tmp-* : garde-fou pour le module ansible.builtin.script
       (pousse et exécute un binaire brut) - suppression via règle enfant niveau 0.
       Deux pièges de decoder Wazuh découverts en testant :
       1. Le pattern PCRE2 lookahead négatif n'est pas honoré par le moteur de règles
          (testé : matchait quand même, contournement via règle enfant niveau 0).
       2. Le décodeur auditd intégré de Wazuh tronque audit.exe au premier tiret
          rencontré (ex. "/tmp/ansible-tmp-123/x" -> "/tmp/ansible", "/tmp/mal-ware"
          -> "/tmp/mal") - d'où le match sur la forme tronquée ci-dessous, pas sur le
          chemin complet. L'exécution normale des modules Ansible (Python) ne
          déclenche de toute façon jamais 100625 : audit.exe résout vers
          l'interpréteur (/usr/bin/python3.x), jamais vers le chemin /tmp (vérifié). -->

  <rule id="100629" level="0">
    <if_sid>100625</if_sid>
    <field name="audit.exe" type="pcre2">^/tmp/ansible$</field>
    <description>Exclusion 100625 : exécution via module ansible.builtin.script (bruit connu)</description>
  </rule>

</group>
