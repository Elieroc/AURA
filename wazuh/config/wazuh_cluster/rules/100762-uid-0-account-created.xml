<!-- SOC-AI - rule 100762 (level 14). Domain: threat_hunting,linux,post_exploitation,
     Naming convention and load-order trap: see rules/README.md -->
<group name="threat_hunting,linux,post_exploitation,">

  <!-- T1136.001 / T1078.003 - direct creation of a UID 0 account. `-o`
       (non-unique) is mandatory to duplicate uid 0, which makes it a very
       reliable marker. Level 14, same signal as 100744 through another path -
       and the one that was actually validated live. -->

  <rule id="100762" level="14">
    <if_group>audit</if_group>
    <field name="audit.key" type="pcre2">^audit-wazuh-c$</field>
    <regex type="pcre2">a\d+="(?:[^"]*/)?(?i:useradd|usermod)"[^\n]*?a\d+="-[a-zA-Z]*u[a-zA-Z]*"\s+a\d+="0"|a\d+="(?:[^"]*/)?(?i:useradd|usermod)"[^\n]*?a\d+="--uid"\s+a\d+="0"</regex>
    <description>Backdoor: UID 0 account created ($(audit.command))</description>
    <mitre>
      <id>T1136.001</id>
      <id>T1078.003</id>
    </mitre>
  </rule>

</group>
