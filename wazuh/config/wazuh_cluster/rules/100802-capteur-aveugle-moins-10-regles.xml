<!-- SOC-AI - regle 100802 (niveau 13). Domaine : soc_selfcheck,wazuh,
     Convention et piege d ordre de chargement : voir rules/README.md -->
<group name="soc_selfcheck,wazuh,">

  <!-- Regles auditd purgees (`auditctl -D`) ou jamais chargees. Le jeu de regles
       versionne (wazuh/config/agent/zz-audit-wazuh.rules) en charge 21 : un
       nombre a un seul chiffre signifie donc une purge, pas une variation
       normale. Distinct de 100801 : ici le noyau audite, mais plus rien n'est
       instrumente - meme cecite, autre cause, autre remediation. -->

  <rule id="100802" level="13">
    <if_sid>100800</if_sid>
    <match type="pcre2">audit_rules=[0-9]\b</match>
    <description>Capteur aveugle : moins de 10 regles auditd chargees - purge probable (auditctl -D)</description>
    <mitre>
      <id>T1562.001</id>
    </mitre>
  </rule>

</group>
