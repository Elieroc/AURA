<!-- SOC-AI - regle 100771 (niveau 0). Domaine : threat_hunting,linux,post_exploitation,
     Convention et piege d ordre de chargement : voir rules/README.md -->
<group name="threat_hunting,linux,post_exploitation,">

  <!-- Exclusion 100770 : le FIM de l'agent Wazuh ouvre ces memes fichiers pour
       en calculer les empreintes, et dpkg/apt les reecrivent a chaque
       installation de paquet. Sans cette exclusion, notre propre surveillance et
       toute mise a jour generent des alertes de persistance. -->

  <rule id="100771" level="0">
    <if_sid>100770</if_sid>
    <field name="audit.exe" type="pcre2">^/var/ossec/|/(?:dpkg|dpkg-deb|apt|apt-get|frontend|systemd(?:-\w+)?|unattended-upgrade)$</field>
    <description>Exclusion 100770 : ecriture par le FIM, le gestionnaire de paquets ou systemd</description>
  </rule>

</group>
