<!-- SOC-AI - regle 100746 (niveau 13). Domaine : persistence,threat_hunting,linux,syscheck,
     Convention et piege d ordre de chargement : voir rules/README.md -->
<group name="persistence,threat_hunting,linux,syscheck,">

  <!-- T1556.003 - module PAM. Un pam_unix.so remplace, ou une ligne
       `auth sufficient pam_permit.so`, accepte n'importe quel mot de passe sur
       tout le systeme. Aucune raison legitime hors mise a jour de paquet. -->

  <rule id="100746" level="13">
    <if_group>syscheck</if_group>
    <field name="file" type="pcre2">^/etc/pam\.d/</field>
    <description>Backdoor d'authentification : configuration PAM modifiee ($(file))</description>
    <mitre><id>T1556.003</id></mitre>
  </rule>

</group>
