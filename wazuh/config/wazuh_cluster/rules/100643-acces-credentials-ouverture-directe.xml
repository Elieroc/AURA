<!-- SOC-AI - regle 100643 (niveau 12). Domaine : threat_hunting,linux,mitre_gaps,
     Convention et piege d ordre de chargement : voir rules/README.md -->
<group name="threat_hunting,linux,mitre_gaps,">

  <!-- Complement de 100653 par le WATCH auditd (`-w /etc/shadow -p rwa`, cf.
       wazuh/config/agent/zz-audit-wazuh.rules). C'est le seul chemin qui capte une
       lecture SANS execve associe : binaire compile, script qui ouvre le fichier,
       ou exfiltration par un process deja en cours.
       Les lecteurs legitimes sont ecartes par 100644 : PAM les invoque a chaque
       authentification, ils representent la quasi-totalite du volume. -->

  <rule id="100643" level="12">
    <if_group>audit</if_group>
    <field name="audit.key" type="pcre2">^audit-wazuh-shadow$</field>
    <description>Acces credentials : ouverture directe de $(audit.file.name) par $(audit.exe)</description>
    <mitre><id>T1003.008</id></mitre>
  </rule>

</group>
