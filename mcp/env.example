# Généré pour SOC-AI — ne jamais commit
WAZUH_HOST=https://wazuh.manager
WAZUH_PORT=55000
WAZUH_USER=wazuh-wui
WAZUH_PASS=<API_PASSWORD de wazuh/.env>
WAZUH_VERIFY_SSL=false
WAZUH_ALLOW_SELF_SIGNED=true

WAZUH_INDEXER_HOST=wazuh.indexer
WAZUH_INDEXER_PORT=9200
WAZUH_INDEXER_USER=admin
WAZUH_INDEXER_PASS=<INDEXER_PASSWORD de wazuh/.env>
WAZUH_INDEXER_SSL=true
WAZUH_INDEXER_VERIFY_SSL=false

ENVIRONMENT=production
MCP_HOST=0.0.0.0
MCP_PORT=3000

AUTH_MODE=bearer
AUTH_SECRET_KEY=<openssl rand -hex 32>
TOKEN_LIFETIME_HOURS=24
MCP_API_KEY=<python3 -c "import secrets;print('wazuh_'+secrets.token_urlsafe(32))">
MCP_API_KEY_SCOPES=wazuh:read wazuh:write

ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*
LOG_LEVEL=INFO
