# Configuration DFIR-IRIS — copier en .env et remplir.
#
#   cp .env.example .env
#
# Générer chaque secret séparément (ne pas réutiliser la même valeur) :
#   openssl rand -hex 32
#
# .env est gitignored. Aucune de ces valeurs ne doit finir dans un commit.

# --- Version ---------------------------------------------------------------
# Release upstream épinglée. Avant de changer : lire le CHANGELOG, les
# migrations de schéma sont irréversibles. Sauvegarder db_data d'abord.
IRIS_VERSION=v2.4.27

# --- Base de données -------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=__CHANGE_ME__
POSTGRES_ADMIN_USER=raptor
POSTGRES_ADMIN_PASSWORD=__CHANGE_ME__
POSTGRES_DB=iris_db
POSTGRES_SERVER=db
POSTGRES_PORT=5432

# --- Secrets applicatifs ---------------------------------------------------
# IRIS_SECRET_KEY signe les sessions ; le salt dérive les hash de mots de
# passe. Changer le salt après création des comptes invalide tous les mots de
# passe existants.
IRIS_SECRET_KEY=__CHANGE_ME__
IRIS_SECURITY_PASSWORD_SALT=__CHANGE_ME__

# --- Réseau / TLS ----------------------------------------------------------
# 8443 et pas 443 : le dashboard Wazuh occupe déjà 443 sur cet hôte.
INTERFACE_HTTPS_PORT=8443
# 127.0.0.1 = accessible seulement depuis l'hôte. Mettre 0.0.0.0 expose
# l'interface au LAN : dans ce cas, remplacer le certificat auto-signé.
IRIS_BIND_ADDR=127.0.0.1

SERVER_NAME=iris.soc.local
CERT_FILENAME=iris_cert.pem
KEY_FILENAME=iris_key.pem

# --- Interne ---------------------------------------------------------------
DOCKERIZED=1
LOG_LEVEL=info
IRIS_UPSTREAM_SERVER=app
IRIS_UPSTREAM_PORT=8000
IRIS_FRONTEND_SERVER=frontend
IRIS_FRONTEND_PORT=5173
CELERY_BROKER=amqp://rabbitmq

# Nombre de process Celery. Par défaut IRIS en lance un par cœur (16 sur cet
# hôte) pour quelques tâches par heure. On garde les cœurs pour le LLM.
IRIS_WORKER_CONCURRENCY=2

# --- Authentification ------------------------------------------------------
IRIS_AUTHENTICATION_TYPE=local

# Compte administrateur créé au premier démarrage. Si IRIS_ADM_PASSWORD est
# laissé vide, IRIS génère un mot de passe aléatoire visible une seule fois
# dans les logs de iris-app (`docker compose logs app | grep -i password`).
#IRIS_ADM_USERNAME=administrator
#IRIS_ADM_EMAIL=admin@soc.local
#IRIS_ADM_PASSWORD=__CHANGE_ME__

# Clé d'API de l'admin. À définir dès maintenant : c'est par elle que le
# soc-agent créera les cases. Format attendu : 64 caractères hexadécimaux.
#   openssl rand -hex 32
# Préférer à terme un compte de service dédié plutôt que l'admin.
#IRIS_ADM_API_KEY=__CHANGE_ME__
